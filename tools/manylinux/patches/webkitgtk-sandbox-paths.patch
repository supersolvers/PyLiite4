+const char* dbusProxyExecutable()
+{
+    static const CString executable = [] {
+        if (const char* execDirectory = g_getenv("WEBKIT_EXEC_PATH")) {
+            GUniquePtr<char> path(g_build_filename(execDirectory, "xdg-dbus-proxy", nullptr));
+            if (g_file_test(path.get(), G_FILE_TEST_IS_EXECUTABLE))
+                return CString(path.get());
+        }
+        return CString(DBUS_PROXY_EXECUTABLE);
+    }();
+    return executable.data();
+}
+
+const char* bwrapExecutable()
+{
+    static const CString executable = [] {
+        GUniquePtr<char> path(g_find_program_in_path("bwrap"));
+        return path ? CString(path.get()) : CString(BWRAP_EXECUTABLE);
+    }();
+    return executable.data();
+}
