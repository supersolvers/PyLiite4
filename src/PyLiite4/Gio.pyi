    @staticmethod
    def get_default() -> TlsBackend:
        """Gets the default Gio.TlsBackend for the system.

        Returns:
            a Gio.TlsBackend, which will be a
                dummy object if no TLS backend is available
        """
    def do_get_default_database(self) -> TlsDatabase:
        """The virtual method behind get_default_database(), for subclasses to override."""
    def do_supports_dtls(self) -> _bool:
        """The virtual method behind supports_dtls(), for subclasses to override."""
    def do_supports_tls(self) -> _bool:
