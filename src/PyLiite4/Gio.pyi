        handler will cause a deadlock and must not be done.
        """
    @classmethod
    def new(cls, connection: DBusConnection, cancellable: Cancellable | None = ...) -> DebugControllerDBus | None:
        """Create a new Gio.DebugControllerDBus and synchronously initialize it.

        Initializing the object will export the debug object on connection. The
        object will remain registered until the last reference to the
        Gio.DebugControllerDBus is dropped.

        Initialization may fail if registering the object on connection fails.

        Args:
            connection: a Gio.DBusConnection to register the debug object on
            cancellable: a Gio.Cancellable, or None

        Returns:
            a new Gio.DebugControllerDBus, or None
                on failure
        """
    def do_authorize(self, invocation: DBusMethodInvocation) -> _bool:
        """Default handler for the Gio.DebugControllerDBus.authorize signal."""
    @property
    def connection(self) -> DBusConnection:
        """The D-Bus connection to expose the debugging interface on.

        Typically this will be the same connection (to the system or session bus)
        which the rest of the application or service’s D-Bus objects are registered
        on.
        """
    @property
    def debug_enabled(self) -> _bool: ...
    @debug_enabled.setter
    def debug_enabled(self, value: _bool) -> None: ...
