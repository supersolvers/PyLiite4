    @classmethod
    def new_from_unix_epoch_local_time(cls, secs: _int) -> DateTime | None:
        """Creates a new Gst.DateTime using the time since Jan 1, 1970 specified by
        secs. The Gst.DateTime is in the local timezone.

        Args:
            secs: seconds from the Unix epoch

        Returns:
            the newly created Gst.DateTime,
                or None on error.
        """
    @classmethod
    def new_from_unix_epoch_local_time_usecs(cls, usecs: _int) -> DateTime | None:
        """Creates a new Gst.DateTime using the time since Jan 1, 1970 specified by
        usecs. The Gst.DateTime is in the local timezone.

        Args:
            usecs: microseconds from the Unix epoch

        Returns:
            a newly created Gst.DateTime, or None
                on error.
        """
    @classmethod
    def new_from_unix_epoch_utc(cls, secs: _int) -> DateTime | None:
        """Creates a new Gst.DateTime using the time since Jan 1, 1970 specified by
        secs. The Gst.DateTime is in the UTC timezone.

        Args:
            secs: seconds from the Unix epoch

        Returns:
            the newly created Gst.DateTime,
                or None on error.
        """
    @classmethod
    def new_from_unix_epoch_utc_usecs(cls, usecs: _int) -> DateTime | None:
        """Creates a new Gst.DateTime using the time since Jan 1, 1970 specified by
        usecs. The Gst.DateTime is in UTC.

        Args:
            usecs: microseconds from the Unix epoch

        Returns:
            a newly created Gst.DateTime, or None
                on error.
        """
    @classmethod
    def new_local_time(cls, year: _int, month: _int, day: _int, hour: _int, minute: _int, seconds: _float) -> DateTime | None:
        """Creates a new Gst.DateTime using the date and times in the gregorian calendar
        in the local timezone.

        year should be from 1 to 9999, month should be from 1 to 12, day from
        1 to 31, hour from 0 to 23, minutes and seconds from 0 to 59.

        If month is -1, then the Gst.DateTime created will only contain year,
        and all other fields will be considered not set.

        If day is -1, then the Gst.DateTime created will only contain year and
        month and all other fields will be considered not set.

        If hour is -1, then the Gst.DateTime created will only contain year and
        month and day, and the time fields will be considered not set. In this
        case minute and seconds should also be -1.

        Args:
            year: the gregorian year
            month: the gregorian month, or -1
            day: the day of the gregorian month, or -1
            hour: the hour of the day, or -1
            minute: the minute of the hour, or -1
            seconds: the second of the minute, or -1

        Returns:
            the newly created Gst.DateTime,
                or None on error.
        """
    @classmethod
    def new_now_local_time(cls) -> DateTime | None:
        """Creates a new Gst.DateTime representing the current date and time.

        Returns:
            the newly created Gst.DateTime which should
                be, or None on error.
        """
    @classmethod
    def new_now_utc(cls) -> DateTime | None:
        """Creates a new Gst.DateTime that represents the current instant at Universal
        coordinated time.

        Returns:
            the newly created Gst.DateTime which should
                be, or None on error.
        """
    @classmethod
    def new_y(cls, year: _int) -> DateTime | None:
        """Creates a new Gst.DateTime using the date and times in the gregorian calendar
        in the local timezone.

        year should be from 1 to 9999.

        Args:
            year: the gregorian year

        Returns:
            the newly created Gst.DateTime,
                or None on error.
        """
    @classmethod
    def new_ym(cls, year: _int, month: _int) -> DateTime | None:
        """Creates a new Gst.DateTime using the date and times in the gregorian calendar
        in the local timezone.

        year should be from 1 to 9999, month should be from 1 to 12.

        If value is -1 then all over value will be ignored. For example
        if month == -1, then Gst.DateTime will created only for year.

        Args:
            year: the gregorian year
            month: the gregorian month

        Returns:
            the newly created Gst.DateTime,
                or None on error.
        """
    @classmethod
    def new_ymd(cls, year: _int, month: _int, day: _int) -> DateTime | None:
        """Creates a new Gst.DateTime using the date and times in the gregorian calendar
        in the local timezone.

        year should be from 1 to 9999, month should be from 1 to 12, day from
        1 to 31.

        If value is -1 then all over value will be ignored. For example
        if month == -1, then Gst.DateTime will created only for year. If
        day == -1, then Gst.DateTime will created for year and month and
        so on.

        Args:
            year: the gregorian year
            month: the gregorian month
            day: the day of the gregorian month

        Returns:
            the newly created Gst.DateTime,
                or None on error.
        """

