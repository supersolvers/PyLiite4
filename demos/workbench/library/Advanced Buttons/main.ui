<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="advanced_buttons">
    <property name="title" translatable="yes">Advanced Buttons</property>
    <property name="description" translatable="yes">Complex buttons with menus and icons</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>
            <property name="halign">center</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Split Button</property>
                <style>
                  <class name="title-4"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">A combined button and dropdown widget</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="halign">center</property>
                <property name="margin-top">12</property>
                <property name="homogeneous">true</property>
                <property name="spacing">18</property>
                <child>
                  <object class="GtkBox">
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="AdwSplitButton">
                        <property name="halign">center</property>
                        <property name="icon-name">media-playback-start-symbolic</property>
                        <property name="menu-model">button_run_menu</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Menu Model</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="AdwSplitButton">
                        <property name="label" translatable="yes">Open</property>
                        <property name="popover">button_popover</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Popover</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="margin-bottom">36</property>
            <property name="label" translatable="yes">API Reference</property>
            <property name="uri">https://gnome.pages.gitlab.gnome.org/libadwaita/doc/1.6/class.SplitButton.html</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>
            <property name="halign">center</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Button Content</property>
                <style>
                  <class name="title-4"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">A helper widget to create buttons with icons and labels</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="halign">center</property>
                <property name="margin-top">12</property>
                <property name="homogeneous">true</property>
                <property name="spacing">18</property>
                <child>
                  <object class="GtkBox">
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkButton">
                        <child>
                          <object class="AdwButtonContent">
                            <property name="label" translatable="yes">Edit</property>
                            <property name="icon-name">document-edit-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Button</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkMenuButton">
                        <property name="menu-model">button_new_menu</property>
                        <child>
                          <object class="AdwButtonContent">
                            <property name="label" translatable="yes">New</property>
                            <property name="icon-name">list-add-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Menu Button</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="margin-top">6</property>
                    <property name="margin-bottom">6</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkToggleButton">
                        <child>
                          <object class="AdwButtonContent">
                            <property name="label" translatable="yes">Bluetooth</property>
                            <property name="icon-name">bluetooth-active-symbolic</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Toggle Button</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">API Reference</property>
            <property name="uri">https://gnome.pages.gitlab.gnome.org/libadwaita/doc/1.6/class.ButtonContent.html</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkPopover" id="button_popover">
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkSearchEntry">
            <property name="placeholder-text" translatable="yes">Search documents</property>
          </object>
        </child>
        <child>
          <object class="AdwStatusPage">
            <property name="title" translatable="yes">No Recent Documents</property>
            <property name="icon-name">document-open-recent-symbolic</property>
            <property name="width-request">300</property>
            <property name="height-request">300</property>
            <style>
              <class name="compact"/>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>
  <menu id="button_new_menu">
    <item>
      <attribute name="label">New File</attribute>
    </item>
    <item>
      <attribute name="label">New Folder</attribute>
    </item>
    <item>
      <attribute name="label">New Window</attribute>
    </item>
  </menu>
  <menu id="button_run_menu">
    <section>
      <item>
        <attribute name="label">Run</attribute>
      </item>
      <item>
        <attribute name="label">Run With Leak Detector</attribute>
      </item>
      <item>
        <attribute name="label">Run With Debugger</attribute>
      </item>
    </section>
    <section>
      <attribute name="label" translatable="yes">Settings</attribute>
      <submenu>
        <attribute name="label" translatable="yes">Accessibility</attribute>
        <item>
          <attribute name="label">High Contrast</attribute>
        </item>
        <section>
          <attribute name="label" translatable="yes">Text Direction</attribute>
          <item>
            <attribute name="label">Left-to-Right</attribute>
          </item>
          <item>
            <attribute name="label">Right-to-Left</attribute>
          </item>
        </section>
      </submenu>
    </section>
  </menu>
</interface>
