<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="spinner_demo">
    <property name="title" translatable="yes">Spinner</property>
    <property name="description" translatable="yes">Display loading state</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <property name="spacing">24</property>
        <child>
          <object class="AdwSpinner" id="spinner">
            <property name="halign">center</property>
            <property name="valign">center</property>
            <property name="width-request">48</property>
            <property name="height-request">48</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button">
            <property name="icon-name">media-playback-stop</property>
            <property name="halign">center</property>
            <style>
              <class name="circular"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">API Reference</property>
                <property name="uri">https://gnome.pages.gitlab.gnome.org/libadwaita/doc/1.6/class.Spinner.html</property>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">Human Interface Guidelines</property>
                <property name="uri">https://developer.gnome.org/hig/patterns/feedback/spinners.html</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
