<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="AdwStatusPage" id="preview">
    <property name="title" translatable="yes">Notification</property>
    <property name="description" translatable="yes">Desktop notifications</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkButton" id="button_simple">
            <property name="label" translatable="yes">Trigger Notification</property>
            <property name="margin-bottom">30</property>
            <style>
              <class name="pill"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">Tutorial</property>
            <property name="uri">https://developer.gnome.org/documentation/tutorials/notifications.html</property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">API Reference</property>
            <property name="uri">https://docs.gtk.org/gio/class.Notification.html</property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">Human Interface Guidelines</property>
            <property name="uri">https://developer.gnome.org/hig/patterns/feedback/notifications.html</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
