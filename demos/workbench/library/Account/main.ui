<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="account">
    <property name="title" translatable="yes">Account</property>
    <property name="description" translatable="yes">Request information about the user</property>
    <property name="margin-top">48</property>
    <child>
      <object class="AdwClamp">
        <property name="maximum-size">340</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="margin-bottom">30</property>
                <property name="spacing">18</property>
                <child>
                  <object class="AdwEntryRow" id="entry">
                    <property name="title" translatable="yes">Reason</property>
                    <style>
                      <class name="card"/>
                    </style>
                    <property name="halign">fill</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="button">
                    <property name="label" translatable="yes">Request</property>
                    <property name="halign">center</property>
                    <style>
                      <class name="suggested-action"/>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkRevealer" id="revealer">
                <property name="transition-duration">300</property>
                <property name="transition-type">slide-up</property>
                <property name="child">
                  <object class="GtkListBox">
                    <property name="selection-mode">none</property>
                    <property name="margin-bottom">18</property>
                    <style>
                      <class name="boxed-list"/>
                    </style>
                    <child>
                      <object class="GtkListBoxRow">
                        <property name="activatable">false</property>
                        <property name="child">
                          <object class="AdwAvatar" id="avatar">
                            <property name="hexpand">true</property>
                            <property name="size">80</property>
                            <property name="margin-bottom">18</property>
                            <property name="margin-top">18</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Username</property>
                        <child>
                          <object class="GtkLabel" id="username">
                            <property name="label" translatable="yes">unknown</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Full name</property>
                        <child>
                          <object class="GtkLabel" id="name">
                            <property name="label" translatable="yes">unknown</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">API Reference</property>
                <property name="uri">https://libportal.org/method.Portal.get_user_information.html</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
