<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="AdwStatusPage" id="preview">
    <property name="title" translatable="yes">Level Bars</property>
    <property name="description" translatable="yes">A bar widget used as a level indicator</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="margin-top">24</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <property name="margin-start">18</property>
            <property name="margin-end">18</property>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Continuous</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkLabel">
                    <property name="halign">start</property>
                    <property name="margin-start">12</property>
                    <property name="margin-top">12</property>
                    <property name="label" translatable="yes">Battery</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLevelBar" id="bar_continuous">
                    <property name="mode">continuous</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-bottom">24</property>
                    <property name="min-value">0</property>
                    <property name="max-value">100</property>
                    <property name="value">50</property>
                  </object>
                </child>
                <style>
                  <class name="card"/>
                </style>
                <property name="margin-bottom">24</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Discrete</property>
              </object>
            </child>
            <child>
              <object class="GtkPasswordEntry" id="entry">
                <property name="placeholder-text" translatable="yes">Password</property>
                <property name="show-peek-icon">true</property>
              </object>
            </child>
            <child>
              <object class="GtkLevelBar" id="bar_discrete">
                <property name="mode">discrete</property>
                <property name="min-value">0</property>
                <property name="max-value">6</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_strength"/>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="margin-bottom">24</property>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">Tutorial</property>
                <property name="uri">https://developer.gnome.org/documentation/tutorials/beginners/components/level_bar.html</property>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">API Reference</property>
                <property name="uri">https://docs.gtk.org/gtk4/class.LevelBar.html</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
