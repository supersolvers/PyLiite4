<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="source_view">
    <property name="title" translatable="yes">Source View</property>
    <property name="description" translatable="yes">Widget that enables text-editing with advanced features like syntax highlighting</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkScrolledWindow" id="scrolled_window">
            <property name="height-request">180</property>
            <property name="width-request">600</property>
            <property name="has-frame">true</property>
            <!-- GtkSource.View, with its GtkSource.Buffer buffer, is built in main.py: GtkSource's types are
                 registered only once main.py imports it. -->
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">Documentation</property>
            <property name="uri">https://gnome.pages.gitlab.gnome.org/gtksourceview/gtksourceview5/</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
