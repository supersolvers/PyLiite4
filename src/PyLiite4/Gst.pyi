    def peer_query(self, query: Query) -> _bool:
        """Performs Gst.Pad.query() on the peer of self.

        The caller is responsible for both the allocation and deallocation of
        the query structure.

        Args:
            query: the Gst.Query to perform.

        Returns:
            True if the query could be performed. This function returns False
