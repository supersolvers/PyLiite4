class NavigationCommand(GObject.GEnum):
    """A set of commands that may be issued to an element providing the
    GstVideo.Navigation interface. The available commands can be queried via
    the GstVideo.Navigation.query_new_commands() query.

    For convenience in handling DVD navigation, the MENU commands are aliased as:
       GST_NAVIGATION_COMMAND_DVD_MENU            = GST_NAVIGATION_COMMAND_MENU1
       GST_NAVIGATION_COMMAND_DVD_TITLE_MENU      = GST_NAVIGATION_COMMAND_MENU2
       GST_NAVIGATION_COMMAND_DVD_ROOT_MENU       = GST_NAVIGATION_COMMAND_MENU3
       GST_NAVIGATION_COMMAND_DVD_SUBPICTURE_MENU = GST_NAVIGATION_COMMAND_MENU4
       GST_NAVIGATION_COMMAND_DVD_AUDIO_MENU      = GST_NAVIGATION_COMMAND_MENU5
       GST_NAVIGATION_COMMAND_DVD_ANGLE_MENU      = GST_NAVIGATION_COMMAND_MENU6
       GST_NAVIGATION_COMMAND_DVD_CHAPTER_MENU    = GST_NAVIGATION_COMMAND_MENU7
    """
    INVALID: NavigationCommand
    """An invalid command entry"""
    MENU1: NavigationCommand
    """Execute navigation menu command 1. For DVD,
    this enters the DVD root menu, or exits back to the title from the menu.
    """
    MENU2: NavigationCommand
    """Execute navigation menu command 2. For DVD,
    this jumps to the DVD title menu.
    """
    MENU3: NavigationCommand
    """Execute navigation menu command 3. For DVD,
    this jumps into the DVD root menu.
    """
    MENU4: NavigationCommand
    """Execute navigation menu command 4. For DVD,
    this jumps to the Subpicture menu.
    """
    MENU5: NavigationCommand
    """Execute navigation menu command 5. For DVD,
    the jumps to the audio menu.
    """
    MENU6: NavigationCommand
    """Execute navigation menu command 6. For DVD,
    this jumps to the angles menu.
    """
    MENU7: NavigationCommand
    """Execute navigation menu command 7. For DVD,
    this jumps to the chapter menu.
    """
    LEFT: NavigationCommand
    """Select the next button to the left in a menu,
    if such a button exists.
    """
    RIGHT: NavigationCommand
    """Select the next button to the right in a menu,
    if such a button exists.
    """
    UP: NavigationCommand
    """Select the button above the current one in a
    menu, if such a button exists.
    """
    DOWN: NavigationCommand
    """Select the button below the current one in a
    menu, if such a button exists.
    """
    ACTIVATE: NavigationCommand
    """Activate (click) the currently selected
    button in a menu, if such a button exists.
    """
    PREV_ANGLE: NavigationCommand
    """Switch to the previous angle in a
    multiangle feature.
    """
    NEXT_ANGLE: NavigationCommand
    """Switch to the next angle in a multiangle
    feature.
    """

class NavigationEventType(GObject.GEnum):
    """Enum values for the various events that an element implementing the
    GstNavigation interface might send up the pipeline. Touch events have been
    inspired by the libinput API, and have the same meaning here.
    """
    INVALID: NavigationEventType
    """Returned from
    GstVideo.Navigation.event_get_type() when the passed event is not a navigation event.
    """
    KEY_PRESS: NavigationEventType
    """A key press event. Use
    GstVideo.Navigation.event_parse_key_event() to extract the details from the event.
    """
    KEY_RELEASE: NavigationEventType
    """A key release event. Use
    GstVideo.Navigation.event_parse_key_event() to extract the details from the event.
    """
    MOUSE_BUTTON_PRESS: NavigationEventType
    """A mouse button press event. Use
    GstVideo.Navigation.event_parse_mouse_button_event() to extract the details from the
    event.
    """
    MOUSE_BUTTON_RELEASE: NavigationEventType
    """A mouse button release event. Use
    GstVideo.Navigation.event_parse_mouse_button_event() to extract the details from the
    event.
    """
    MOUSE_MOVE: NavigationEventType
    """A mouse movement event. Use
    GstVideo.Navigation.event_parse_mouse_move_event() to extract the details from the
    event.
    """
    COMMAND: NavigationEventType
    """A navigation command event. Use
    GstVideo.Navigation.event_parse_command() to extract the details from the event.
    """
    MOUSE_SCROLL: NavigationEventType
    """A mouse scroll event. Use GstVideo.Navigation.event_parse_mouse_scroll_event()
    to extract the details from the event.
    """
    TOUCH_DOWN: NavigationEventType
    """An event describing a new touch point, which will be assigned an identifier
    that is unique to it for the duration of its movement on the screen.
    Use GstVideo.Navigation.event_parse_touch_event() to extract the details
    from the event.
    """
    TOUCH_MOTION: NavigationEventType
    """An event describing the movement of an active touch point across
    the screen. Use GstVideo.Navigation.event_parse_touch_event() to extract
    the details from the event.
    """
    TOUCH_UP: NavigationEventType
    """An event describing a removed touch point. After this event,
    its identifier may be reused for any new touch points.
    Use GstVideo.Navigation.event_parse_touch_up_event() to extract the details
    from the event.
    """
    TOUCH_FRAME: NavigationEventType
    """An event signaling the end of a sequence of simultaneous touch events."""
    TOUCH_CANCEL: NavigationEventType
    """An event cancelling all currently active touch points."""
    MOUSE_DOUBLE_CLICK: NavigationEventType
    """A mouse button double click event.
    Use GstVideo.Navigation.event_parse_mouse_button_event() to extract the details
    from the event.
    """

class NavigationInterface:
    """Navigation interface."""
    iface: GObject.TypeInterface

class NavigationMessageType(GObject.GEnum):
    """A set of notifications that may be received on the bus when navigation
    related status changes.
    """
    INVALID: NavigationMessageType
    """Returned from
    GstVideo.Navigation.message_get_type() when the passed message is not a
    navigation message.
    """
    MOUSE_OVER: NavigationMessageType
    """Sent when the mouse moves over or leaves a
    clickable region of the output, such as a DVD menu button.
    """
    COMMANDS_CHANGED: NavigationMessageType
    """Sent when the set of available commands
    changes and should re-queried by interested applications.
    """
    ANGLES_CHANGED: NavigationMessageType
    """Sent when display angles in a multi-angle
    feature (such as a multiangle DVD) change - either angles have appeared or
    disappeared.
    """
    EVENT: NavigationMessageType
    """Sent when a navigation event was not handled
    by any element in the pipeline (Since: 1.6)
    """

class NavigationModifierType(GObject.GFlags):
    """Flags to indicate the state of modifier keys and mouse buttons
    in events.

    Typical modifier keys are Shift, Control, Meta, Super, Hyper, Alt, Compose,
    Apple, CapsLock or ShiftLock.
    """
    NONE: NavigationModifierType
    SHIFT_MASK: NavigationModifierType
    """the Shift key."""
    LOCK_MASK: NavigationModifierType
    CONTROL_MASK: NavigationModifierType
    """the Control key."""
    MOD1_MASK: NavigationModifierType
    """the third modifier key"""
    MOD2_MASK: NavigationModifierType
    """the fourth modifier key"""
    MOD3_MASK: NavigationModifierType
    """the fifth modifier key"""
    MOD4_MASK: NavigationModifierType
    """the sixth modifier key"""
    MOD5_MASK: NavigationModifierType
    """the seventh modifier key"""
    BUTTON1_MASK: NavigationModifierType
    """the first mouse button (usually the left button)."""
    BUTTON2_MASK: NavigationModifierType
    """the second mouse button (usually the right button)."""
    BUTTON3_MASK: NavigationModifierType
    """the third mouse button (usually the mouse wheel button or middle button)."""
    BUTTON4_MASK: NavigationModifierType
    """the fourth mouse button (typically the "Back" button)."""
    BUTTON5_MASK: NavigationModifierType
    """the fifth mouse button (typically the "forward" button)."""
    SUPER_MASK: NavigationModifierType
    """the Super modifier"""
    HYPER_MASK: NavigationModifierType
    """the Hyper modifier"""
    META_MASK: NavigationModifierType
    """the Meta modifier"""
    MASK: NavigationModifierType
    """A mask covering all entries in Gdk.ModifierType."""

class NavigationQueryType(GObject.GEnum):
    """Types of navigation interface queries."""
    INVALID: NavigationQueryType
    """invalid query"""
    COMMANDS: NavigationQueryType
    """command query"""
    ANGLES: NavigationQueryType
    """viewing angle query"""

