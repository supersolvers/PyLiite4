        """Reads a Unicode character from self.
        This function cannot be called on a channel with None encoding.

        Returns:
            a GLib.IOStatus
            thechar: a location to return a character
        """
    def ref(self) -> IOChannel:
        """Increments the reference count of a GLib.IOChannel.

        Returns:
            the self that was passed in (since 2.6)
        """
    def seek(self, offset: _int, type: SeekType) -> IOError:
