class TaskPool(Object):
    """This object provides an abstraction for creating threads. The default
    implementation uses a regular GThreadPool to start tasks.

    Subclasses can be made to create custom threads.
    """
    props: _TaskPoolProps  # type: ignore[assignment]
    def __init__(self, *, name: _str = ..., parent: Object = ..., **properties: _Any) -> None: ...
    def cleanup(self) -> None:
        """Wait for all tasks to be stopped. This is mainly used internally
        to ensure proper cleanup of internal data structures in test suites.

        MT safe.
        """
    def dispose_handle(self, id: _Any = ...) -> None:
        """Dispose of the handle returned by Gst.TaskPool.push(). This does
        not need to be called with the default implementation as the default
        #GstTaskPoolClass::push implementation always returns None. This does not need to be
        called either when calling Gst.TaskPool.join(), but should be called
        when joining is not necessary, but Gst.TaskPool.push() returned a
        non-None value.

        This method should only be called with the same self instance that provided
        id.

        Args:
            id: the id
        """
    def join(self, id: _Any = ...) -> None:
        """Join a task and/or return it to the pool. id is the id obtained from
        Gst.TaskPool.push(). The default implementation does nothing, as the
        default #GstTaskPoolClass::push implementation always returns None.

        This method should only be called with the same self instance that provided
        id.

        Args:
            id: the id
        """
    def prepare(self) -> None:
        """Prepare the taskpool for accepting Gst.TaskPool.push() operations.

        MT safe.
        """
    def push(self, func: TaskPoolFunction) -> _Any:
        """Start the execution of a new thread from self.

        Args:
            func: the function to call

        Returns:
            a pointer that should be used
                for the gst_task_pool_join function. This pointer can be None, you
                must check error to detect errors. If the pointer is not None and
                Gst.TaskPool.join() is not used, call Gst.TaskPool.dispose_handle()
                instead.
        """
    @classmethod
    def new(cls) -> TaskPool:
        """Create a new default task pool. The default task pool will use a regular
        GThreadPool for threads.

        Returns:
            a new Gst.TaskPool. Gst.Object.unref() after usage.
        """
    def do_cleanup(self) -> None:
        """The virtual method behind cleanup(), for subclasses to override."""
    def do_dispose_handle(self, id: _Any = ...) -> None:
        """The virtual method behind dispose_handle(), for subclasses to override."""
    def do_join(self, id: _Any = ...) -> None:
        """The virtual method behind join(), for subclasses to override."""
    def do_prepare(self) -> None:
        """The virtual method behind prepare(), for subclasses to override."""
    def do_push(self, func: TaskPoolFunction) -> _Any:
        """The virtual method behind push(), for subclasses to override."""

