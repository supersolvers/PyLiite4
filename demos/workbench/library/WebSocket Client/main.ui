<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="websocket_client">
    <property name="title" translatable="yes">WebSocket Client</property>
    <property name="description" translatable="yes">Connect to a WebSocket server</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkEntry" id="entry_url">
            <property name="placeholder-text" translatable="yes">url</property>
            <property name="text" translatable="yes">wss://ws.postman-echo.com/raw</property>
            <property name="margin-bottom">24</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_connect">
            <property name="label" translatable="yes">Connect</property>
            <property name="margin-bottom">24</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_disconnect">
            <property name="label" translatable="yes">Disconnect</property>
            <property name="sensitive">false</property>
            <property name="margin-bottom">24</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkEntry" id="entry_message">
                <property name="margin-end">12</property>
                <property name="hexpand">true</property>
                <property name="placeholder-text" translatable="yes">Message</property>
                <property name="text" translatable="yes">Hello</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_send">
                <property name="label" translatable="yes">Send</property>
                <property name="sensitive">false</property>
              </object>
            </child>
            <property name="margin-bottom">30</property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">GJS Asynchronous Operations</property>
            <property name="uri">https://gjs.guide/guides/gjs/asynchronous-programming.html#asynchronous-operations</property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">API Reference</property>
            <property name="uri">https://libsoup.gnome.org/libsoup-3.0/class.WebsocketConnection.html</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
