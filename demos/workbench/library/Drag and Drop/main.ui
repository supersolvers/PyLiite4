<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="drag_and_drop">
    <property name="title" translatable="yes">Drag and Drop</property>
    <property name="description" translatable="yes">A User interaction pattern where users drag a UI element from one place to another</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="AdwClamp">
            <property name="maximum-size">400</property>
            <child>
              <object class="GtkListBox" id="list">
                <style>
                  <class name="boxed-list"/>
                </style>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Row 1</property>
                <child type="prefix">
                  <object class="GtkImage">
                    <style>
                      <class name="dim-label"/>
                    </style>
                    <property name="icon-name">list-drag-handle-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Row 2</property>
                <child type="prefix">
                  <object class="GtkImage">
                    <style>
                      <class name="dim-label"/>
                    </style>
                    <property name="icon-name">list-drag-handle-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Row 3</property>
                <child type="prefix">
                  <object class="GtkImage">
                    <style>
                      <class name="dim-label"/>
                    </style>
                    <property name="icon-name">list-drag-handle-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Row 4</property>
                <child type="prefix">
                  <object class="GtkImage">
                    <style>
                      <class name="dim-label"/>
                    </style>
                    <property name="icon-name">list-drag-handle-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title" translatable="yes">Row 5</property>
                <child type="prefix">
                  <object class="GtkImage">
                    <style>
                      <class name="dim-label"/>
                    </style>
                    <property name="icon-name">list-drag-handle-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">API Reference</property>
            <property name="uri">https://docs.gtk.org/gtk4/drag-and-drop.html</property>
            <property name="margin-top">24</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
