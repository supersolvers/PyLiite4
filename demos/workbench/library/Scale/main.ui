<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="scale">
    <property name="title" translatable="yes">Scale</property>
    <property name="description" translatable="yes">Slider control to select a value from a range</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkBox">
            <property name="halign">center</property>
            <child>
              <object class="GtkScale" id="one">
                <property name="orientation">horizontal</property>
                <property name="margin-bottom">18</property>
                <property name="width-request">130</property>
                <property name="draw-value">true</property>
                <property name="margin-end">36</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">0</property>
                    <property name="upper">100</property>
                    <property name="value">0</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkScale" id="two">
                <property name="orientation">vertical</property>
                <property name="margin-bottom">18</property>
                <property name="height-request">140</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">0</property>
                    <property name="upper">100</property>
                    <property name="value">0</property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScale" id="disabled">
            <property name="orientation">horizontal</property>
            <property name="sensitive">false</property>
            <property name="margin-bottom">18</property>
            <property name="show-fill-level">true</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="lower">0</property>
                <property name="upper">50</property>
                <property name="value">25</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkScaleButton" id="button">
            <property name="orientation">horizontal</property>
            <property name="margin-bottom">18</property>
            <property name="halign">center</property>
            <property name="adjustment">
              <object class="GtkAdjustment">
                <property name="lower">0</property>
                <property name="upper">100</property>
                <property name="value">0</property>
                <property name="page-increment">15</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">Scale API Reference</property>
            <property name="uri">https://docs.gtk.org/gtk4/class.Scale.html</property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">ScaleButton API Reference</property>
            <property name="uri">https://docs.gtk.org/gtk4/class.ScaleButton.html</property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">Human Interface Guidelines</property>
            <property name="uri">https://developer.gnome.org/hig/patterns/controls/sliders.html</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
