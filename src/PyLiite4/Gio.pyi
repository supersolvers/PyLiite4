    DEFAULT: ResolverNameLookupFlags
    """default behavior (same as Gio.Resolver.lookup_by_name())"""
    IPV4_ONLY: ResolverNameLookupFlags
    """only resolve ipv4 addresses"""
    IPV6_ONLY: ResolverNameLookupFlags
