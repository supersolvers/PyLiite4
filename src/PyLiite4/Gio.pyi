        Note that doing so invalidates the hash computed by prior calls
        to Gio.Icon.hash().

        Args:
            iconname: name of icon to append to list of icons from within self.
        """
    def get_names(self) -> _list[_str]:
        """Gets the names of icons from within self.

        Returns:
            a list of icon names.
        """
    def prepend_name(self, iconname: _str) -> None:
        """Prepend a name to the list of icons from within self.

        Note that doing so invalidates the hash computed by prior calls
        to Gio.Icon.hash().

        Args:
            iconname: name of icon to prepend to list of icons from within self.
        """
    @classmethod
    def new(cls, iconname: _str) -> ThemedIcon:
        """Creates a new themed icon for iconname.

        Args:
            iconname: a string containing an icon name.

        Returns:
            a new Gio.ThemedIcon.
        """
    @classmethod
    def new_from_names(cls, iconnames: _list[_str]) -> ThemedIcon:
        """Creates a new themed icon for iconnames.

        Args:
            iconnames: an array of strings containing icon names.

        Returns:
            a new Gio.ThemedIcon
        """
    @classmethod
    def new_with_default_fallbacks(cls, iconname: _str) -> ThemedIcon:
        """Creates a new themed icon for iconname, and all the names
        that can be created by shortening iconname at '-' characters.

        In the following example, icon1 and icon2 are equivalent:
        ```c
        const char *names[] = {
          "gnome-dev-cdrom-audio",
          "gnome-dev-cdrom",
          "gnome-dev",
          "gnome"
        };

        icon1 = g_themed_icon_new_from_names (names, 4);
        icon2 = g_themed_icon_new_with_default_fallbacks ("gnome-dev-cdrom-audio");
        ```

        Args:
            iconname: a string containing an icon name

        Returns:
            a new Gio.ThemedIcon.
        """
    @property
    def names(self) -> _list[_str]:
        """A NULL-terminated array of icon names."""
    @property
    def use_default_fallbacks(self) -> _bool:
        """Whether to use the default fallbacks found by shortening the icon name
        at '-' characters. If the "names" array has more than one element,
        ignores any past the first.

        For example, if the icon name was "gnome-dev-cdrom-audio", the array
        would become
        ```c
        {
          "gnome-dev-cdrom-audio",
          "gnome-dev-cdrom",
          "gnome-dev",
          "gnome",
          NULL
        };
        ```
        """

