        """Links self to sink, creating any Gst.GhostPad's in between as necessary.

        This is a convenience function to save having to create and add intermediate
        Gst.GhostPad's as required for linking across Gst.Bin boundaries.

        If self or sink pads don't have parent elements or do not share a common
        ancestor, the link will fail.

        Args:
            sink: a Gst.Pad

        Returns:
            whether the link succeeded.
        """
    def link_maybe_ghosting_full(self, sink: Pad, flags: PadLinkCheck) -> _bool:
        """Links self to sink, creating any Gst.GhostPad's in between as necessary.

        This is a convenience function to save having to create and add intermediate
        Gst.GhostPad's as required for linking across Gst.Bin boundaries.

        If self or sink pads don't have parent elements or do not share a common
        ancestor, the link will fail.

        Calling Gst.Pad.link_maybe_ghosting_full() with
        flags == Gst.PadLinkCheck.DEFAULT is the recommended way of linking
        pads with safety checks applied.

        Args:
            sink: a Gst.Pad
            flags: some Gst.PadLinkCheck flags

        Returns:
            whether the link succeeded.
        """
