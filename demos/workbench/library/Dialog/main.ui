<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="dialog_demo">
    <property name="title" translatable="yes">Dialog</property>
    <property name="description" translatable="yes">An adaptive dialog container</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <property name="spacing">28</property>
        <child>
          <object class="GtkListBox">
            <property name="width-request">320</property>
            <property name="selection-mode">none</property>
            <style>
              <class name="boxed-list"/>
            </style>
            <child>
              <object class="AdwComboRow" id="combo_row">
                <property name="title" translatable="yes">Presentation Mode</property>
                <property name="model">
                  <object class="GtkStringList" id="list">
                    <items>
                      <item translatable="yes">Auto</item>
                      <item translatable="yes">Floating</item>
                      <item translatable="yes">Bottom Sheet</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button">
            <property name="label" translatable="yes">Open Dialog</property>
            <property name="halign">center</property>
            <style>
              <class name="suggested-action"/>
              <class name="pill"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">API Reference</property>
                <property name="uri">https://gnome.pages.gitlab.gnome.org/libadwaita/doc/1.6/class.Dialog.html</property>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">Human Interface Guidelines</property>
                <property name="uri">https://developer.gnome.org/hig/patterns/feedback/dialogs.html</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="AdwDialog" id="dialog">
    <property name="can-close">false</property>
    <binding name="presentation-mode">
      <lookup name="selected" type="AdwComboRow">combo_row</lookup>
    </binding>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="GtkImage" id="image">
            <property name="pixel-size">320</property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
