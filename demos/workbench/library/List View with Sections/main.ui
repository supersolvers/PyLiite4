<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="AdwStatusPage" id="preview">
    <property name="title" translatable="yes">List View with Sections</property>
    <property name="description" translatable="yes">Divide items in a list view with sections</property>
    <property name="valign">start</property>
    <child>
      <object class="AdwClamp">
        <property name="maximum-size">360</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">18</property>
            <child>
              <object class="GtkScrolledWindow">
                <property name="height-request">330</property>
                <property name="has-frame">true</property>
                <property name="child">
                  <object class="GtkListView" id="list_view">
                    <property name="factory">
                      <object class="GtkSignalListItemFactory" id="item_factory"/>
                    </property>
                    <property name="header-factory">
                      <object class="GtkSignalListItemFactory" id="header_factory"/>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="halign">center</property>
                <child>
                  <object class="GtkLinkButton">
                    <property name="label" translatable="yes">API Reference</property>
                    <property name="uri">https://docs.gtk.org/gtk4/iface.SectionModel.html</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLinkButton">
                    <property name="label" translatable="yes">Documentation</property>
                    <property name="uri">https://docs.gtk.org/gtk4/section-list-widget.html#sections</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
