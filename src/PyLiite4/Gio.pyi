    props: _TlsCertificateProps  # type: ignore[assignment]
    def __init__(self, *, certificate: _bytes = ..., certificate_pem: _str = ..., issuer: TlsCertificate = ..., password: _str = ..., pkcs11_uri: _str = ..., pkcs12_data: _bytes = ..., private_key: _bytes = ..., private_key_pem: _str = ..., private_key_pkcs11_uri: _str = ..., **properties: _Any) -> None: ...
