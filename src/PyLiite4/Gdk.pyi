    """Creates `Gdk.ContentFormats` objects."""
    def add_formats(self, formats: ContentFormats) -> None:
        """Appends all formats from formats to self, skipping those that
        already exist.

        Args:
            formats: the formats to add
        """
    def add_gtype(self, type: _GTypeLike) -> None:
        """Appends type to self if it has not already been added.

        Args:
            type: a `GObject.Type`
        """
    def add_mime_type(self, mime_type: _str) -> None:
        """Appends mime_type to self if it has not already been added.

        Args:
            mime_type: a mime type
        """
    def ref(self) -> ContentFormatsBuilder:
        """Acquires a reference on the given self.

        This function is intended primarily for bindings.
        `Gdk.ContentFormatsBuilder` objects should not be kept around.

        Returns:
