<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwBin" id="bottom_sheet_demo">
    <child>
      <object class="AdwBottomSheet" id="bottom_sheet">
        <property name="bottom-bar">
          <object class="GtkLabel">
            <property name="label" translatable="yes">Bottom Bar</property>
            <property name="margin-bottom">12</property>
            <property name="margin-end">12</property>
            <property name="margin-start">12</property>
            <property name="margin-top">12</property>
          </object>
        </property>
        <property name="content">
          <object class="AdwStatusPage">
            <property name="description" translatable="yes">Display content with a bottom sheet</property>
            <property name="title" translatable="yes">Bottom Sheet</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="halign">center</property>
                <child>
                  <object class="AdwClamp">
                    <property name="child">
                      <object class="AdwPreferencesGroup">
                        <child>
                          <object class="AdwSwitchRow">
                            <property name="active" bind-source="bottom_sheet" bind-property="full-width" bind-flags="sync-create|bidirectional"/>
                            <property name="title" translatable="yes">Full Width</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSwitchRow">
                            <property name="active" bind-source="bottom_sheet" bind-property="can-open" bind-flags="sync-create|bidirectional"/>
                            <property name="title" translatable="yes">Can Open</property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSwitchRow">
                            <property name="active" bind-source="bottom_sheet" bind-property="open" bind-flags="sync-create|bidirectional"/>
                            <property name="title" translatable="yes">Open</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkLinkButton">
                    <property name="label" translatable="yes">API Reference</property>
                    <property name="uri">https://gnome.pages.gitlab.gnome.org/libadwaita/doc/main/class.BottomSheet.html</property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
        <property name="sheet">
          <object class="AdwStatusPage">
            <property name="width-request">360</property>
            <property name="title" translatable="yes">Sheet</property>
            <property name="child">
              <object class="AdwClamp">
                <property name="child">
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="AdwSwitchRow">
                        <property name="active" bind-source="bottom_sheet" bind-property="can-close" bind-flags="sync-create|bidirectional"/>
                        <property name="title" translatable="yes">Can Close</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow">
                        <property name="active" bind-source="bottom_sheet" bind-property="show-drag-handle" bind-flags="sync-create|bidirectional"/>
                        <property name="title" translatable="yes">Show Drag Handle</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow">
                        <property name="active" bind-source="bottom_sheet" bind-property="modal" bind-flags="sync-create|bidirectional"/>
                        <property name="title" translatable="yes">Modal</property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </object>
</interface>
