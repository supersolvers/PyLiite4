    CONTROL_PAGE_UP: TabViewShortcuts
    """Ctrl+Page Up - switch to the previous page"""
    CONTROL_PAGE_DOWN: TabViewShortcuts
    """Ctrl+Page Down - switch to the next page"""
    CONTROL_HOME: TabViewShortcuts
    """Ctrl+Home - switch to the first page"""
    CONTROL_END: TabViewShortcuts
    """Ctrl+End - switch to the last page"""
    CONTROL_SHIFT_PAGE_UP: TabViewShortcuts
    """Ctrl+Shift+Page Up - move the selected
      page backward
    """
    CONTROL_SHIFT_PAGE_DOWN: TabViewShortcuts
    """Ctrl+Shift+Page Down - move the selected
      page forward
    """
    CONTROL_SHIFT_HOME: TabViewShortcuts
    """Ctrl+Shift+Home - move the selected page
      at the start
    """
    CONTROL_SHIFT_END: TabViewShortcuts
    """Ctrl+Shift+End - move the current page at
      the end
    """
    ALT_DIGITS: TabViewShortcuts
    """Alt+1⋯9 - switch to pages 1-9"""
    ALT_ZERO: TabViewShortcuts
    """Alt+0 - switch to page 10"""
    ALL_SHORTCUTS: TabViewShortcuts
    """All of the shortcuts"""

