        """The virtual method behind enumerate(), for subclasses to override."""
    def do_proxy_enumerate(self) -> SocketAddressEnumerator:
        """The virtual method behind proxy_enumerate(), for subclasses to override."""
    def do_to_string(self) -> _str:
        """The virtual method behind to_string(), for subclasses to override."""

