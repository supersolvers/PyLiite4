<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="preview">
    <property name="default-width">800</property>
    <property name="default-height">800</property>
    <property name="title" translatable="yes">Flow Box Demo</property>
    <property name="titlebar">
      <object class="AdwHeaderBar"/>
    </property>
    <child>
      <object class="AdwStatusPage">
        <property name="title" translatable="yes">Flow Box</property>
        <property name="description" translatable="yes">Puts child widgets in a reflowing grid</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">12</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkScrolledWindow">
                <property name="propagate-natural-height">true</property>
                <property name="has-frame">true</property>
                <child>
                  <object class="GtkFlowBox" id="flowbox">
                    <property name="orientation">horizontal</property>
                    <property name="row-spacing">6</property>
                    <property name="column-spacing">6</property>
                    <property name="homogeneous">true</property>
                    <property name="max-children-per-line">6</property>
                    <property name="min-children-per-line">3</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">API Reference</property>
                <property name="uri">https://docs.gtk.org/gtk4/class.FlowBox.html</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
