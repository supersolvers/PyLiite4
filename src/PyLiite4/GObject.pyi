    lcopy_format: _str
    collect_value: TypeValueCollectFunc
    collect_format: _str
    value_peek_pointer: TypeValuePeekPointerFunc
    value_copy: TypeValueCopyFunc
    value_free: TypeValueFreeFunc
    value_init: TypeValueInitFunc

