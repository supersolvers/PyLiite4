class Native(GObject.GInterface):
    """An interface for widgets that have their own Gdk.Surface.

    The obvious example of a `Gtk.Native` is `Gtk.Window`.

    Every widget that is not itself a `Gtk.Native` is contained in one,
    and you can get it with Gtk.Widget.get_native().

    To get the surface of a `Gtk.Native`, use Gtk.Native.get_surface().
    It is also possible to find the `Gtk.Native` to which a surface
    belongs, with Gtk.Native.get_for_surface().

    In addition to a Gdk.Surface, a `Gtk.Native` also provides
    a Gsk.Renderer for rendering on that surface. To get the
    renderer, use Gtk.Native.get_renderer().
    """
    @property
    def realize(self) -> _SignalMethod[_Callable[[Native], None], _Callable[[], None]]:
        """Realizes a `Gtk.Native`.

        This should only be used by subclasses.
        """
    @property
    def unrealize(self) -> _SignalMethod[_Callable[[Native], None], _Callable[[], None]]:
        """Unrealizes a `Gtk.Native`.

        This should only be used by subclasses.
        """
    def get_renderer(self) -> Gsk.Renderer | None:
        """Returns the renderer that is used for this `Gtk.Native`.

        Returns:
            the renderer for self
        """
    def get_surface(self) -> Gdk.Surface | None:
        """Returns the surface of this `Gtk.Native`.

        Returns:
            the surface of self
        """
    def get_surface_transform(self) -> _tuple[_float, _float]:
        """Retrieves the surface transform of self.

        This is the translation from self's surface coordinates into
        self's widget coordinates.

        Returns:
            x: return location for the x coordinate
            y: return location for the y coordinate
        """
    @staticmethod
    def get_for_surface(surface: Gdk.Surface) -> Native | None:
        """Finds the `Gtk.Native` associated with the surface.

        Args:
            surface: a `Gdk.Surface`

        Returns:
            the `Gtk.Native` that is associated with surface
        """

