<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="svg">
    <property name="title" translatable="yes">SVG</property>
    <property name="description" translatable="yes">Display vectorial images at arbitrary sizes</property>
    <child>
      <object class="GtkBox">
        <property name="halign">center</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkDrawingArea" id="drawing_area">
            <property name="width-request">128</property>
            <property name="height-request">128</property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">Librsvg documentation</property>
            <property name="uri">https://gnome.pages.gitlab.gnome.org/librsvg/Rsvg-2.0/index.html</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
