        Pool details can be retrieved using Gst.Query.get_n_allocation_pools() and
        Gst.Query.parse_nth_allocation_pool().

        Returns:
            caps: The Gst.Caps
            need_pool: Whether a Gst.BufferPool is needed
        """
    def parse_bitrate(self) -> _int:
        """Get the results of a bitrate query. See also Gst.Query.set_bitrate().

        Returns:
            The resulting bitrate in bits per second
        """
    def parse_buffering_percent(self) -> _tuple[_bool, _int]:
        """Get the percentage of buffered data. This is a value between 0 and 100.
