<?xml version="1.0" encoding="UTF-8"?>
<!-- Without a domain="..." attribute here, GtkBuilder translates with the domain that textdomain() set. -->
<interface>
  <object class="GtkBox" id="content">
    <property name="orientation">vertical</property>
    <property name="spacing">12</property>
    <property name="margin-top">24</property>
    <property name="margin-bottom">24</property>
    <property name="margin-start">24</property>
    <property name="margin-end">24</property>
    <child>
      <object class="GtkLabel">
        <property name="label" translatable="yes">This line comes from the .ui file.</property>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="greeting">
        <property name="label" translatable="yes" comments="Shown until the button is pressed">Not greeted yet</property>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="greet-button">
        <!-- A context tells apart strings that are the same in English but not in every language. -->
        <property name="label" translatable="yes" context="verb">_Greet</property>
        <property name="use-underline">true</property>
        <property name="halign">center</property>
      </object>
    </child>
  </object>
</interface>
