    @classmethod
    def new(cls) -> ContentFormatsBuilder:
        """Create a new `Gdk.ContentFormatsBuilder` object.

        The resulting builder would create an empty `Gdk.ContentFormats`.
        Use addition functions to add types to it.

        Returns:
            a new `Gdk.ContentFormatsBuilder`
        """

