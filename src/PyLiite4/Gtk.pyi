    """Slide in from the right"""
    SLIDE_UP: RevealerTransitionType
    """Slide in from the bottom"""
    SLIDE_DOWN: RevealerTransitionType
    """Slide in from the top"""
    SWING_RIGHT: RevealerTransitionType
