    def get_connection_type(self) -> WebsocketConnectionType:
        """Get the connection type (client/server) of the connection.

        Returns:
            the connection type
        """
    def get_extensions(self) -> _list[WebsocketExtension]:
        """Get the extensions chosen via negotiation with the peer.

        Returns:
            a GLib.List of Soup.WebsocketExtension objects
        """
    def get_io_stream(self) -> Gio.IOStream:
        """Get the I/O stream the WebSocket is communicating over.

        Returns:
            the WebSocket's I/O stream.
        """
    def get_keepalive_interval(self) -> _int:
        """Gets the keepalive interval in seconds or 0 if disabled.

        Returns:
            the keepalive interval.
        """
    def get_keepalive_pong_timeout(self) -> _int:
        """Gets the keepalive pong timeout in seconds or 0 if disabled.

        Returns:
            the keepalive pong timeout.
        """
    def get_max_incoming_payload_size(self) -> _int:
        """Gets the maximum payload size allowed for incoming packets.

