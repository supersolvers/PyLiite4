    def get_listeners(self) -> _list[Gio.Socket]:
        """Gets self's list of listening sockets.

        You should treat these sockets as read-only; writing to or
        modifiying any of these sockets may cause self to malfunction.

        Returns:
            a
                list of listening sockets.
        """
    def get_tls_auth_mode(self) -> Gio.TlsAuthenticationMode:
        """Gets the self SSL/TLS client authentication mode.

        Returns:
            a Gio.TlsAuthenticationMode
        """
    def get_tls_certificate(self) -> Gio.TlsCertificate | None:
        """Gets the self SSL/TLS certificate.

        Returns:
            a Gio.TlsCertificate or None
        """
    def get_tls_database(self) -> Gio.TlsDatabase | None:
        """Gets the self SSL/TLS database.

        Returns:
            a Gio.TlsDatabase
        """
    def get_uris(self) -> _list[GLib.Uri]:
