class Revealer(Widget):
    """Animates the transition of its child from invisible to visible.

    The style of transition can be controlled with
    Gtk.Revealer.set_transition_type().

    These animations respect the Gtk.Settings.props.gtk_enable_animations
    setting.

    # CSS nodes

    `Gtk.Revealer` has a single CSS node with name revealer.
    When styling `Gtk.Revealer` using CSS, remember that it only hides its contents,
    not itself. That means applied margin, padding and borders will be visible even
    when the Gtk.Revealer.props.reveal_child property is set to False.

    # Accessibility

    `Gtk.Revealer` uses the Gtk.AccessibleRole.GROUP role.

    The child of `Gtk.Revealer`, if set, is always available in the accessibility
    tree, regardless of the state of the revealer widget.
    """
    props: _RevealerProps  # type: ignore[assignment]
    def __init__(self, *, child: Widget = ..., reveal_child: _bool = ..., transition_duration: _int = ..., transition_type: RevealerTransitionType = ..., can_focus: _bool = ..., can_target: _bool = ..., css_classes: _list[_str] = ..., css_name: _str = ..., cursor: Gdk.Cursor = ..., focus_on_click: _bool = ..., focusable: _bool = ..., halign: Align = ..., has_tooltip: _bool = ..., height_request: _int = ..., hexpand: _bool = ..., hexpand_set: _bool = ..., layout_manager: LayoutManager = ..., limit_events: _bool = ..., margin_bottom: _int = ..., margin_end: _int = ..., margin_start: _int = ..., margin_top: _int = ..., name: _str = ..., opacity: _float = ..., overflow: Overflow = ..., receives_default: _bool = ..., sensitive: _bool = ..., tooltip_markup: _str = ..., tooltip_text: _str = ..., valign: Align = ..., vexpand: _bool = ..., vexpand_set: _bool = ..., visible: _bool = ..., width_request: _int = ..., accessible_role: AccessibleRole = ..., **properties: _Any) -> None: ...
    def get_child(self) -> Widget | None:
        """Gets the child widget of self.

        Returns:
            the child widget of self
        """
    def get_child_revealed(self) -> _bool:
        """Returns whether the child is fully revealed.

        In other words, this returns whether the transition
        to the revealed state is completed.

        Returns:
            True if the child is fully revealed
        """
    def get_reveal_child(self) -> _bool:
        """Returns whether the child is currently revealed.

        This function returns True as soon as the transition
        is to the revealed state is started. To learn whether
        the child is fully revealed (ie the transition is completed),
        use Gtk.Revealer.get_child_revealed().

        Returns:
            True if the child is revealed.
        """
    def get_transition_duration(self) -> _int:
        """Returns the amount of time (in milliseconds) that
        transitions will take.

        Returns:
            the transition duration
        """
    def get_transition_type(self) -> RevealerTransitionType:
        """Gets the type of animation that will be used
        for transitions in self.

        Returns:
            the current transition type of self
        """
    def set_child(self, child: Widget | None = ...) -> None:
        """Sets the child widget of self.

        Args:
            child: the child widget
        """
    def set_reveal_child(self, reveal_child: _bool) -> None:
        """Tells the `Gtk.Revealer` to reveal or conceal its child.

        The transition will be animated with the current
        transition type of self.

        Args:
            reveal_child: True to reveal the child
        """
    def set_transition_duration(self, duration: _int) -> None:
        """Sets the duration that transitions will take.

        Args:
            duration: the new duration, in milliseconds
        """
    def set_transition_type(self, transition: RevealerTransitionType) -> None:
        """Sets the type of animation that will be used for
        transitions in self.

        Available types include various kinds of fades and slides.

        Args:
            transition: the new transition type
        """
    @classmethod
    def new(cls) -> Widget:
        """Creates a new `Gtk.Revealer`.

        Returns:
            a newly created `Gtk.Revealer`
        """
    @property
    def child(self) -> Widget:
        """The child widget."""
    @child.setter
    def child(self, value: Widget) -> None: ...
    @property
    def child_revealed(self) -> _bool:
        """Whether the child is revealed and the animation target reached."""
    @property
    def reveal_child(self) -> _bool:
        """Whether the revealer should reveal the child."""
    @reveal_child.setter
    def reveal_child(self, value: _bool) -> None: ...
    @property
    def transition_duration(self) -> _int:
        """The animation duration, in milliseconds."""
    @transition_duration.setter
    def transition_duration(self, value: _int) -> None: ...
    @property
    def transition_type(self) -> RevealerTransitionType:
        """The type of animation used to transition."""
    @transition_type.setter
    def transition_type(self, value: RevealerTransitionType) -> None: ...
    @property
    def accessible_role(self) -> AccessibleRole: ...
    @accessible_role.setter
    def accessible_role(self, value: AccessibleRole) -> None: ...

class RevealerTransitionType(GObject.GEnum):
    """These enumeration values describe the possible transitions
    when the child of a `Gtk.Revealer` widget is shown or hidden.
