            the newly created `Gio.AppInfo`
        """
    def exists(self) -> _bool:
        """Checks whether the resource pointed by self still exists.
        At the moment this check is done only on resources pointing
        to local files.

        Returns:
            True if the resource exists
        """
    def get_added(self) -> GLib.DateTime:
        """Gets the time when the resource
        was added to the recently used resources list.

        Returns:
            a `GLib.DateTime` for the time
                when the resource was added
        """
    def get_age(self) -> _int:
