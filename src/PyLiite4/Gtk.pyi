        """Causes the given text to appear next to the progress bar.

        If text is None and Gtk.ProgressBar.props.show_text is True,
        the current value of Gtk.ProgressBar.props.fraction will be displayed
        as a percentage.

        If text is non-None and Gtk.ProgressBar.props.show_text is True,
        the text will be displayed. In this case, it will not display the progress
        percentage. If text is the empty string, the progress bar will still
        be styled and sized suitably for containing text, as long as
        Gtk.ProgressBar.props.show_text is True.

        Args:
            text: a UTF-8 string
        """
    @classmethod
    def new(cls) -> Widget:
        """Creates a new `Gtk.ProgressBar`.

        Returns:
            a `Gtk.ProgressBar`.
        """
    @property
    def ellipsize(self) -> Pango.EllipsizeMode:
        """The preferred place to ellipsize the string.

        The text will be ellipsized if the progress bar does not have enough room
        to display the entire string, specified as a `Pango.EllipsizeMode`.

        Note that setting this property to a value other than
        Pango.EllipsizeMode.NONE has the side-effect that the progress bar requests
        only enough space to display the ellipsis ("..."). Another means to set a
        progress bar's width is Gtk.Widget.set_size_request().
        """
    @ellipsize.setter
    def ellipsize(self, value: Pango.EllipsizeMode) -> None: ...
    @property
    def fraction(self) -> _float:
        """The fraction of total work that has been completed."""
    @fraction.setter
    def fraction(self, value: _float) -> None: ...
    @property
    def inverted(self) -> _bool:
        """Invert the direction in which the progress bar grows."""
    @inverted.setter
    def inverted(self, value: _bool) -> None: ...
    @property
    def pulse_step(self) -> _float:
        """The fraction of total progress to move the bounding block when pulsed."""
    @pulse_step.setter
    def pulse_step(self, value: _float) -> None: ...
    @property
    def show_text(self) -> _bool:
        """Sets whether the progress bar will show a text in addition
        to the bar itself.

        The shown text is either the value of the Gtk.ProgressBar.props.text
        property or, if that is None, the Gtk.ProgressBar.props.fraction
        value, as a percentage.

        To make a progress bar that is styled and sized suitably for showing text
        (even if the actual text is blank), set Gtk.ProgressBar.props.show_text
        to True and Gtk.ProgressBar.props.text to the empty string (not None).
        """
    @show_text.setter
    def show_text(self, value: _bool) -> None: ...
    @property
    def text(self) -> _str:
        """Text to be displayed in the progress bar."""
    @text.setter
    def text(self, value: _str) -> None: ...
    @property
    def accessible_role(self) -> AccessibleRole: ...
    @accessible_role.setter
    def accessible_role(self, value: AccessibleRole) -> None: ...
    @property
    def orientation(self) -> Orientation: ...
    @orientation.setter
    def orientation(self, value: Orientation) -> None: ...

class PropagationLimit(GObject.GEnum):
    """Describes limits of a EventController for handling events
    targeting other widgets.
    """
    NONE: PropagationLimit
    """Events are handled regardless of what their
      target is.
    """
    SAME_NATIVE: PropagationLimit
    """Events are only handled if their target is in
      the same Native (or widget with Gtk.Widget.props.limit_events
      set) as the event controllers widget.
      Note that some event types have two targets (origin and destination).
    """

class PropagationPhase(GObject.GEnum):
    """Describes the stage at which events are fed into a EventController."""
    NONE: PropagationPhase
    """Events are not delivered."""
    CAPTURE: PropagationPhase
    """Events are delivered in the capture phase. The
      capture phase happens before the bubble phase, runs from the toplevel down
      to the event widget. This option should only be used on containers that
      might possibly handle events before their children do.
    """
    BUBBLE: PropagationPhase
    """Events are delivered in the bubble phase. The bubble
      phase happens after the capture phase, and before the default handlers
      are run. This phase runs from the event widget, up to the toplevel.
    """
    TARGET: PropagationPhase
    """Events are delivered in the default widget event handlers,
      note that widget implementations must chain up on button, motion, touch and
      grab broken handlers for controllers in this phase to be run.
    """

