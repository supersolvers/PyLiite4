        Returns:
            the page setup of self
        """
    def get_pango_fontmap(self) -> Pango.FontMap:
        """Returns a `Pango.FontMap` that is suitable for use
        with the `Gtk.PrintContext`.

        Returns:
            the font map of self
        """
    def get_width(self) -> _float:
        """Obtains the width of the `Gtk.PrintContext`, in pixels.

        Returns:
            the width of self
        """
    def set_cairo_context(self, cr: _cairo.Context, dpi_x: _float, dpi_y: _float) -> None:
