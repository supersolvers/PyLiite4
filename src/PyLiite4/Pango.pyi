class Matrix:
    """A `Pango.Matrix` specifies a transformation between user-space
    and device coordinates.

    The transformation is given by

    ```
    x_device = x_user * matrix->xx + y_user * matrix->xy + matrix->x0;
    y_device = x_user * matrix->yx + y_user * matrix->yy + matrix->y0;
    ```
    """
    y0: _float
    x0: _float
    yy: _float
    yx: _float
    xy: _float
    xx: _float
    def concat(self, new_matrix: Matrix) -> None:
        """Changes the transformation represented by self to be the
        transformation given by first applying transformation
        given by new_matrix then applying the original transformation.

        Args:
            new_matrix: a `Pango.Matrix`
        """
    def copy(self) -> Matrix | None:
        """Copies a `Pango.Matrix`.

        Returns:
            the newly allocated `Pango.Matrix`
        """
    def free(self) -> None: ...
    def get_font_scale_factor(self) -> _float:
        """Returns the scale factor of a matrix on the height of the font.

        That is, the scale factor in the direction perpendicular to the
        vector that the X coordinate is mapped to.  If the scale in the X
        coordinate is needed as well, use Pango.Matrix.get_font_scale_factors().

        Returns:
            the scale factor of self on the height of the font,
                or 1.0 if self is None.
        """
    def get_font_scale_factors(self) -> _tuple[_float, _float]:
        """Calculates the scale factor of a matrix on the width and height of the font.

        That is, xscale is the scale factor in the direction of the X coordinate,
        and yscale is the scale factor in the direction perpendicular to the
        vector that the X coordinate is mapped to.

        Note that output numbers will always be non-negative.

        Returns:
            xscale: output scale factor in the x direction
            yscale: output scale factor perpendicular to the x direction
        """
    def get_slant_ratio(self) -> _float:
        """Gets the slant ratio of a matrix.

        For a simple shear matrix in the form:

            1 λ
            0 1

        this is simply λ.

        Returns:
            the slant ratio of self
        """
    def rotate(self, degrees: _float) -> None:
        """Changes the transformation represented by self to be the
        transformation given by first rotating by degrees degrees
        counter-clockwise then applying the original transformation.

        Args:
            degrees: degrees to rotate counter-clockwise
        """
    def scale(self, scale_x: _float, scale_y: _float) -> None:
        """Changes the transformation represented by self to be the
        transformation given by first scaling by sx in the X direction
        and sy in the Y direction then applying the original
        transformation.

        Args:
            scale_x: amount to scale by in X direction
            scale_y: amount to scale by in Y direction
