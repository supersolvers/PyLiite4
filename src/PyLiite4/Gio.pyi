    BYTE_STRING: FileAttributeType
    """a zero terminated string of non-zero bytes."""
    BOOLEAN: FileAttributeType
    """a boolean value."""
    UINT32: FileAttributeType
    """an unsigned 4-byte/32-bit integer."""
    INT32: FileAttributeType
    """a signed 4-byte/32-bit integer."""
    UINT64: FileAttributeType
    """an unsigned 8-byte/64-bit integer."""
    INT64: FileAttributeType
