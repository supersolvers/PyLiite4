class Sample:
    """A Gst.Sample is a small object containing data, a type, timing and
    extra arbitrary information.
    """
    def get_buffer(self) -> Buffer | None:
        """Get the buffer associated with self

        Returns:
            the buffer of self or None
                when there is no buffer. The buffer remains valid as long as
                self is valid.  If you need to hold on to it for longer than
                that, take a ref to the buffer with gst_buffer_ref().
        """
    def get_buffer_list(self) -> BufferList | None:
        """Get the buffer list associated with self

        Returns:
            the buffer list of self or None
                when there is no buffer list. The buffer list remains valid as long as
                self is valid.  If you need to hold on to it for longer than
                that, take a ref to the buffer list with Gst.MiniObject.ref().
        """
    def get_caps(self) -> Caps | None:
        """Get the caps associated with self

        Returns:
            the caps of self or None
                when there is no caps. The caps remain valid as long as self is
                valid.  If you need to hold on to the caps for longer than that,
                take a ref to the caps with gst_caps_ref().
        """
    def get_info(self) -> Structure | None:
        """Get extra information associated with self.

        Returns:
            the extra info of self.
                The info remains valid as long as self is valid.
        """
    def get_segment(self) -> Segment:
        """Get the segment associated with self

        Returns:
            the segment of self.
                The segment remains valid as long as self is valid.
        """
    def set_buffer(self, buffer: Buffer) -> None:
        """Set the buffer associated with self. self must be writable.

        Args:
            buffer: A Gst.Buffer
        """
    def set_buffer_list(self, buffer_list: BufferList) -> None:
        """Set the buffer list associated with self. self must be writable.

        Args:
            buffer_list: a Gst.BufferList
        """
    def set_caps(self, caps: Caps) -> None:
        """Set the caps associated with self. self must be writable.

        Args:
            caps: A Gst.Caps
        """
    def set_info(self, info: Structure) -> _bool:
        """Set the info structure associated with self. self must be writable,
        and info must not have a parent set already.

        Args:
            info: A Gst.Structure
        """
    def set_segment(self, segment: Segment) -> None:
        """Set the segment associated with self. self must be writable.

        Args:
            segment: A Gst.Segment
        """
    @classmethod
    def new(cls, buffer: Buffer | None = ..., caps: Caps | None = ..., segment: Segment | None = ..., info: Structure | None = ...) -> Sample:
        """Create a new Gst.Sample with the provided details.

        Args:
            buffer: a Gst.Buffer, or None
