<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="tooltip">
    <property name="title" translatable="yes">Tooltip</property>
    <property name="description" translatable="yes">Show additional information about controls or app content</property>
    <child>
      <object class="GtkBox">
        <property name="halign">center</property>
        <property name="valign">center</property>
        <property name="spacing">24</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">24</property>
            <child>
              <object class="GtkToggleButton">
                <property name="tooltip-text" translatable="yes">Do Not Disturb</property>
                <property name="icon-name">notifications-disabled-symbolic</property>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="label" translatable="yes">Open…</property>
                <property name="tooltip-markup" translatable="yes">&lt;i&gt;Select a File&lt;/i&gt;</property>
                <style>
                  <class name="pill"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button">
                <property name="has-tooltip">true</property>
                <property name="label" translatable="yes">Custom</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label" translatable="yes">Hover the buttons to see tooltips</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="halign">center</property>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">API Reference</property>
                <property name="uri">https://docs.gtk.org/gtk4/class.Tooltip.html</property>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">Human Interface Guidelines</property>
                <property name="uri">https://developer.gnome.org/hig/patterns/feedback/tooltips</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
