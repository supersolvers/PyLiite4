    def set_activatemode_function_full(self, activatemode: PadActivateModeFunction) -> None:
        """Sets the given activate_mode function for the pad. An activate_mode function
        prepares the element for data passing.

        Args:
            activatemode: the Gst.PadActivateModeFunction to set.
        """
    def set_active(self, active: _bool) -> _bool:
        """Activates or deactivates the given pad.
        Normally called from within core state change functions.

        If active, makes sure the pad is active. If it is already active, either in
        push or pull mode, just return. Otherwise dispatches to the pad's activate
        function to perform the actual activation.

        If not active, calls Gst.Pad.activate_mode() with the pad's current mode
        and a False argument.

        Args:
            active: whether or not the pad should be active.

        Returns:
            True if the operation was successful.

                MT safe.
        """
    def set_chain_function_full(self, chain: PadChainFunction) -> None:
        """Sets the given chain function for the pad. The chain function is called to
        process a Gst.Buffer input buffer. see Gst.PadChainFunction for more details.

        Args:
            chain: the Gst.PadChainFunction to set.
        """
    def set_chain_list_function_full(self, chainlist: PadChainListFunction) -> None:
        """Sets the given chain list function for the pad. The chainlist function is
        called to process a Gst.BufferList input buffer list. See
        Gst.PadChainListFunction for more details.

        Args:
            chainlist: the Gst.PadChainListFunction to set.
        """
    def set_element_private(self, priv: _Any = ...) -> None:
        """Set the given private data gpointer on the pad.
        This function can only be used by the element that owns the pad.
        No locking is performed in this function.

        Args:
            priv: The private data to attach to the pad.
        """
    def set_event_full_function_full(self, event: PadEventFullFunction) -> None:
        """Sets the given event handler for the pad.

        Args:
            event: the Gst.PadEventFullFunction to set.
        """
    def set_event_function_full(self, event: PadEventFunction) -> None:
        """Sets the given event handler for the pad.

        Args:
            event: the Gst.PadEventFunction to set.
        """
    def set_getrange_function_full(self, get: PadGetRangeFunction) -> None:
        """Sets the given getrange function for the pad. The getrange function is
        called to produce a new Gst.Buffer to start the processing pipeline. see
        Gst.PadGetRangeFunction for a description of the getrange function.

        Args:
            get: the Gst.PadGetRangeFunction to set.
        """
    def set_iterate_internal_links_function_full(self, iterintlink: PadIterIntLinkFunction) -> None:
        """Sets the given internal link iterator function for the pad.

        Args:
            iterintlink: the Gst.PadIterIntLinkFunction to set.
        """
    def set_link_function_full(self, link: PadLinkFunction) -> None:
        """Sets the given link function for the pad. It will be called when
        the pad is linked with another pad.

        The return value Gst.PadLinkReturn.OK should be used when the connection can be
        made.

        The return value Gst.PadLinkReturn.REFUSED should be used when the connection
        cannot be made for some reason.

        If link is installed on a source pad, it should call the Gst.PadLinkFunction
        of the peer sink pad, if present.

        Args:
            link: the Gst.PadLinkFunction to set.
        """
    def set_offset(self, offset: _int) -> None:
        """Set the offset that will be applied to the running time of self. Upon next
        buffer, every sticky events (notably segment) will be pushed again with
        their running time adjusted. For that reason this is only reliable on
        source pads.

        Args:
            offset: the offset
        """
    def set_query_function_full(self, query: PadQueryFunction) -> None:
        """Set the given query function for the pad.

        Args:
            query: the Gst.PadQueryFunction to set.
        """
    def set_unlink_function_full(self, unlink: PadUnlinkFunction) -> None:
        """Sets the given unlink function for the pad. It will be called
        when the pad is unlinked.

