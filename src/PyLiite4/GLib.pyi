        """Decreases the reference count of the given value. If it drops to 0
        then the value and its corresponding key are destroyed, using the
        value_destroy_func and key_destroy_func passed to GLib.Cache.new().

        Deprecated since 2.32: Use a GLib.HashTable instead

        Args:
            value: the value to remove
        """
    def value_foreach(self, func: HFunc) -> None:
        """Calls the given function for each of the values in the GLib.Cache.

        Deprecated since 2.10: The reason is that it passes pointers to internal
           data structures to func; use GLib.Cache.key_foreach() instead

        Args:
            func: the function to call with each GLib.Cache value
        """

