    def __init__(self, *, current_page: _int = ..., embed_page_setup: _bool = ..., has_selection: _bool = ..., manual_capabilities: PrintCapabilities = ..., page_setup: PageSetup = ..., print_settings: PrintSettings = ..., support_selection: _bool = ..., use_header_bar: _int = ..., accessible_role: AccessibleRole = ..., application: Application = ..., child: Widget = ..., decorated: _bool = ..., default_height: _int = ..., default_widget: Widget = ..., default_width: _int = ..., deletable: _bool = ..., destroy_with_parent: _bool = ..., display: Gdk.Display = ..., focus_visible: _bool = ..., focus_widget: Widget = ..., fullscreened: _bool = ..., gravity: WindowGravity = ..., handle_menubar_accel: _bool = ..., hide_on_close: _bool = ..., icon_name: _str = ..., maximized: _bool = ..., mnemonics_visible: _bool = ..., modal: _bool = ..., resizable: _bool = ..., startup_id: _str = ..., title: _str = ..., titlebar: Widget = ..., transient_for: Window = ..., can_focus: _bool = ..., can_target: _bool = ..., css_classes: _list[_str] = ..., css_name: _str = ..., cursor: Gdk.Cursor = ..., focus_on_click: _bool = ..., focusable: _bool = ..., halign: Align = ..., has_tooltip: _bool = ..., height_request: _int = ..., hexpand: _bool = ..., hexpand_set: _bool = ..., layout_manager: LayoutManager = ..., limit_events: _bool = ..., margin_bottom: _int = ..., margin_end: _int = ..., margin_start: _int = ..., margin_top: _int = ..., name: _str = ..., opacity: _float = ..., overflow: Overflow = ..., receives_default: _bool = ..., sensitive: _bool = ..., tooltip_markup: _str = ..., tooltip_text: _str = ..., valign: Align = ..., vexpand: _bool = ..., vexpand_set: _bool = ..., visible: _bool = ..., width_request: _int = ..., **properties: _Any) -> None: ...
    def add_custom_tab(self, child: Widget, tab_label: Widget) -> None:
