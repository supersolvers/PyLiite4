<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="status_page">
    <property name="title" translatable="yes">Status Page</property>
    <property name="description" translatable="yes">A page used for empty/error states and similar use-cases</property>
    <property name="icon-name">help-about-symbolic</property>
    <child>
      <object class="GtkBox">
        <property name="margin-top">18</property>
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">API Reference</property>
            <property name="uri">https://gnome.pages.gitlab.gnome.org/libadwaita/doc/1.6/class.StatusPage.html</property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">Human Interface Guidelines</property>
            <property name="uri">https://developer.gnome.org/hig/patterns/feedback/placeholders.html</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
