<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="screenshot">
    <property name="title" translatable="yes">Screenshot</property>
    <property name="description" translatable="yes">Take a picture of the screen</property>
    <property name="margin-top">48</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkPicture" id="picture"/>
            </child>
            <property name="margin-bottom">12</property>
            <property name="width-request">256</property>
            <property name="height-request">256</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button">
            <property name="label" translatable="yes">Take Screenshot</property>
            <property name="margin-bottom">42</property>
            <property name="halign">center</property>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">API Reference</property>
            <property name="uri">https://libportal.org/method.Portal.take_screenshot.html</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
