            the maximum payload size.
        """
    def get_origin(self) -> _str | None:
        """Get the origin of the WebSocket.

        Returns:
            the origin
        """
    def get_protocol(self) -> _str | None:
        """Get the protocol chosen via negotiation with the peer.

        Returns:
            the chosen protocol
