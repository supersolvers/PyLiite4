        Args:
            index: position in the allocator array to read

        Returns:
            allocator: variable to hold the result
            params: parameters for the allocator
        """
    def parse_nth_allocation_pool(self, index: _int) -> _tuple[BufferPool | None, _int, _int, _int]:
        """Get the pool parameters in self.

