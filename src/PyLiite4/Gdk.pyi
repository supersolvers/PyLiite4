class _KeyEventProps(_EventProps):
    ...

class KeyEvent(Event):
    """An event related to a key-based device."""
    props: _KeyEventProps  # type: ignore[assignment]
    def get_consumed_modifiers(self) -> ModifierType:
        """Extracts the consumed modifiers from a key event.

        Returns:
            the consumed modifiers or self
        """
    def get_keycode(self) -> _int:
        """Extracts the keycode from a key event.

        Returns:
            the keycode of self
        """
    def get_keyval(self) -> _int:
        """Extracts the keyval from a key event.

        Returns:
            the keyval of self
        """
    def get_layout(self) -> _int:
        """Extracts the layout from a key event.

        Returns:
            the layout of self
        """
    def get_level(self) -> _int:
        """Extracts the shift level from a key event.

        Returns:
            the shift level of self
        """
    def get_match(self) -> _tuple[_bool, _int, ModifierType]:
        """Gets a keyval and modifier combination that will match
        the event.

        See Gdk.KeyEvent.matches().

        Returns:
            True on success
            keyval: return location for a keyval
            modifiers: return location for modifiers
        """
    def is_modifier(self) -> _bool:
        """Extracts whether the key event is for a modifier key.

        Returns:
            True if the self is for a modifier key
        """
    def matches(self, keyval: _int, modifiers: ModifierType) -> KeyMatch:
        """Matches a key event against a keyval and modifiers.

        This is typically used to trigger keyboard shortcuts such as Ctrl-C.

        Partial matches are possible where the combination matches
        if the currently active group is ignored.

        Note that we ignore Caps Lock for matching.

        Args:
            keyval: the keyval to match
            modifiers: the modifiers to match

        Returns:
            a `Gdk.KeyMatch` value describing whether self matches
        """

class KeyMatch(GObject.GEnum):
    """Describes how well an event matches a given keyval and modifiers.

    `Gdk.KeyMatch` values are returned by Gdk.KeyEvent.matches().
    """
    NONE: KeyMatch
    """The key event does not match"""
    PARTIAL: KeyMatch
    """The key event matches if keyboard state
      (specifically, the currently active group) is ignored
    """
    EXACT: KeyMatch
    """The key event matches"""

class KeymapKey:
