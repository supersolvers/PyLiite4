            src_value: the storage for the source value, or None
            dest_format: the storage for the Gst.Format of the
                destination value, or None
            dest_value: the storage for the destination value,
                or None
        """
    def parse_duration(self) -> _tuple[Format, _int]:
        """Parse a duration query answer. Write the format of the duration into format,
        and the value into duration, if the respective variables are non-None.

        Returns:
            format: the storage for the Gst.Format of the duration
                value, or None.
            duration: the storage for the total duration, or None.
        """
    def parse_latency(self) -> _tuple[_bool, ClockTime, ClockTime]:
        """Parse a latency query answer.

        Returns:
            live: storage for live or None
            min_latency: the storage for the min latency or None
            max_latency: the storage for the max latency or None
        """
    def parse_n_formats(self) -> _int:
        """Parse the number of formats in the formats self.

        Returns:
            the number of formats in this query.
        """
    def parse_nth_allocation_meta(self, index: _int) -> _tuple[GObject.GType, Structure]:
        """Parse an available query and get the metadata API
