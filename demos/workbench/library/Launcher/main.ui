<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="AdwStatusPage" id="preview">
    <property name="title" translatable="yes">Launcher</property>
    <property name="description" translatable="yes">Open a file or URI</property>
    <child>
      <object class="AdwClamp">
        <property name="maximum-size">640</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">24</property>
            <child>
              <object class="GtkStackSwitcher">
                <property name="stack">stack</property>
                <property name="halign">center</property>
              </object>
            </child>
            <child>
              <object class="GtkStack" id="stack">
                <property name="transition-type">crossfade</property>
                <property name="vexpand">true</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">file_launcher</property>
                    <property name="title" translatable="yes">File Launcher</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="halign">center</property>
                        <property name="spacing">24</property>
                        <child>
                          <object class="GtkBox">
                            <property name="halign">center</property>
                            <property name="spacing">6</property>
                            <property name="orientation">horizontal</property>
                            <property name="homogeneous">true</property>
                            <child>
                              <object class="GtkButton" id="launch_file">
                                <property name="label" translatable="yes">Launch</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="file_location">
                                <property name="label" translatable="yes">View in Files</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="change_file">
                            <property name="label" translatable="yes">Select File</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="halign">center</property>
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes">Select File…</property>
                                    <style>
                                      <class name="title-4"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="file_name">
                                    <property name="label" translatable="yes">workbench.txt</property>
                                    <style>
                                      <class name="dim-label"/>
                                      <class name="body"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLinkButton">
                            <property name="label" translatable="yes">API Reference</property>
                            <property name="uri">https://docs.gtk.org/gtk4/class.FileLauncher.html</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">uri_launcher</property>
                    <property name="title" translatable="yes">URI Launcher</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="halign">center</property>
                        <property name="spacing">24</property>
                        <child>
                          <object class="GtkBox">
                            <property name="halign">center</property>
                            <child>
                              <object class="GtkButton" id="uri_launch">
                                <property name="label" translatable="yes">Launch</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="uri_details">
                            <property name="placeholder-text" translatable="yes">URL</property>
                            <property name="text" translatable="yes">https://gnome.org</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLinkButton">
                            <property name="label" translatable="yes">API Reference</property>
                            <property name="uri">https://docs.gtk.org/gtk4/class.UriLauncher.html</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
