        """

InstallPluginsResultFunc = _Callable[..., None]
"""The prototype of the callback function that will be called once the
external plugin installer program has returned. You only need to provide
a callback function if you are using the asynchronous interface.
"""

class InstallPluginsReturn(GObject.GEnum):
    """Result codes returned by GstPbutils.install_plugins_async() and
    GstPbutils.install_plugins_sync(), and also the result code passed to the
    GstPbutils.InstallPluginsResultFunc specified with GstPbutils.install_plugins_async().

    These codes indicate success or failure of starting an external installer
    program and to what extent the requested plugins could be installed.
    """
    SUCCESS: InstallPluginsReturn
    """all of the requested plugins could be
        installed
    """
    NOT_FOUND: InstallPluginsReturn
    """no appropriate installation candidate for
        any of the requested plugins could be found. Only return this if nothing
        has been installed. Return GstPbutils.InstallPluginsReturn.PARTIAL_SUCCESS if
        some (but not all) of the requested plugins could be installed.
    """
    ERROR: InstallPluginsReturn
    """an error occurred during the installation. If
        this happens, the  user has already seen an error message and another
        one should not be displayed
    """
    PARTIAL_SUCCESS: InstallPluginsReturn
    """some of the requested plugins could
        be installed, but not all
    """
    USER_ABORT: InstallPluginsReturn
    """the user has aborted the installation"""
    CRASHED: InstallPluginsReturn
    """the installer had an unclean exit code
        (ie. death by signal)
    """
    INVALID: InstallPluginsReturn
    """the helper returned an invalid status code"""
    STARTED_OK: InstallPluginsReturn
    """returned by GstPbutils.install_plugins_async() to
        indicate that everything went fine so far and the provided callback
        will be called with the result of the installation later
    """
    INTERNAL_FAILURE: InstallPluginsReturn
    """some internal failure has
        occurred when trying to start the installer
    """
    HELPER_MISSING: InstallPluginsReturn
    """the helper script to call the
        actual installer is not installed
    """
    INSTALL_IN_PROGRESS: InstallPluginsReturn
    """a previously-started plugin
        installation is still in progress, try again later
    """
    @staticmethod
    def get_name(ret: InstallPluginsReturn) -> _str:
        """Convenience function to return the descriptive string associated
        with a status code.  This function returns English strings and
        should not be used for user messages. It is here only to assist
        in debugging.

        Args:
            ret: the return status code

        Returns:
            a descriptive string for the status code in ret
        """

