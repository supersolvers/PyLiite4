class Node:
    """The GLib.Node struct represents one node in a [n-ary tree](data-structures.html#n-ary-trees)."""
    children: Node
    parent: Node
    prev: Node
    next: Node
    data: _Any
    def child_index(self, data: _Any = ...) -> _int:
        """Gets the position of the first child of a GLib.Node
        which contains the given data.

        Args:
            data: the data to find

        Returns:
            the index of the child of self which contains
                data, or -1 if the data is not found
        """
    def child_position(self, child: Node) -> _int:
        """Gets the position of a GLib.Node with respect to its siblings.
        child must be a child of self. The first child is numbered 0,
        the second 1, and so on.

        Args:
            child: a child of self

        Returns:
            the position of child with respect to its siblings
        """
    def children_foreach(self, flags: TraverseFlags, func: NodeForeachFunc) -> None:
        """Calls a function for each of the children of a GLib.Node. Note that it
        doesn't descend beneath the child nodes. func must not do anything
        that would modify the structure of the tree.

        Args:
            flags: which types of children are to be visited, one of
                GLib.TraverseFlags.ALL, GLib.TraverseFlags.LEAVES and GLib.TraverseFlags.NON_LEAVES
            func: the function to call for each visited node
        """
    def depth(self) -> _int:
        """Gets the depth of a GLib.Node.

        If self is None the depth is 0. The root node has a depth of 1.
        For the children of the root node the depth is 2. And so on.

        Returns:
            the depth of the GLib.Node
        """
    def destroy(self) -> None:
        """Removes self and its children from the tree, freeing any memory
        allocated.
        """
    def is_ancestor(self, descendant: Node) -> _bool:
        """Returns True if self is an ancestor of descendant.
        This is true if node is the parent of descendant,
        or if node is the grandparent of descendant etc.

        Args:
            descendant: a GLib.Node

        Returns:
            True if self is an ancestor of descendant
        """
    def max_height(self) -> _int:
        """Gets the maximum height of all branches beneath a GLib.Node.
        This is the maximum distance from the GLib.Node to all leaf nodes.

        If self is None, 0 is returned. If self has no children,
        1 is returned. If self has children, 2 is returned. And so on.

        Returns:
            the maximum height of the tree beneath self
        """
    def n_children(self) -> _int:
        """Gets the number of children of a GLib.Node.

        Returns:
            the number of children of self
        """
    def n_nodes(self, flags: TraverseFlags) -> _int:
        """Gets the number of nodes in a tree.

        Args:
            flags: which types of children are to be counted, one of
                GLib.TraverseFlags.ALL, GLib.TraverseFlags.LEAVES and GLib.TraverseFlags.NON_LEAVES

        Returns:
            the number of nodes in the tree
        """
    def reverse_children(self) -> None:
        """Reverses the order of the children of a GLib.Node.
        (It doesn't change the order of the grandchildren.)
        """
    def traverse(self, order: TraverseType, flags: TraverseFlags, max_depth: _int, func: NodeTraverseFunc) -> None:
        """Traverses a tree starting at the given root GLib.Node.
        It calls the given function for each node visited.
        The traversal can be halted at any point by returning True from func.
        func must not do anything that would modify the structure of the tree.

        Args:
            order: the order in which nodes are visited - GLib.TraverseType.IN_ORDER,
                GLib.TraverseType.PRE_ORDER, GLib.TraverseType.POST_ORDER, or GLib.TraverseType.LEVEL_ORDER.
            flags: which types of children are to be visited, one of
                GLib.TraverseFlags.ALL, GLib.TraverseFlags.LEAVES and GLib.TraverseFlags.NON_LEAVES
            max_depth: the maximum depth of the traversal. Nodes below this
                depth will not be visited. If max_depth is -1 all nodes in
                the tree are visited. If depth is 1, only the root is visited.
                If depth is 2, the root and its children are visited. And so on.
            func: the function to call for each visited GLib.Node
        """
    def unlink(self) -> None:
        """Unlinks a GLib.Node from a tree, resulting in two separate trees."""
    @staticmethod
    def pop_allocator() -> None:
        """Deprecated since 2.10."""
    @staticmethod
    def push_allocator(allocator: Allocator) -> None:
        """Deprecated since 2.10."""

NodeForeachFunc = _Callable[..., None]
"""Specifies the type of function passed to GLib.Node.children_foreach().
The function is called with each child node, together with the user
data passed to GLib.Node.children_foreach().
"""

NodeTraverseFunc = _Callable[..., _bool]
"""Specifies the type of function passed to GLib.Node.traverse(). The
function is called with each of the nodes visited, together with the
user data passed to GLib.Node.traverse(). If the function returns
True, then the traversal is stopped.
