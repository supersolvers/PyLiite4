class Settings(GObject.Object):
    """A representation of the settings exposed by the portal.

    The Settings object is used to access and observe the settings
    exposed by xdg-desktop-portal.

    It is obtained from Portal.get_settings(). Call
    Settings.read_value() to read a settings value. Connect to
    Settings.changed to observe value changes.
    """
    props: _SettingsProps  # type: ignore[assignment]
    @property
    def changed(self) -> _BoundSignal[_Callable[[Settings, _str, _str, GLib.Variant], None]]:
        """Emitted when a setting value is changed externally."""
    def read_all_values(self, namespaces: _str, cancellable: Gio.Cancellable | None = ...) -> GLib.Variant:
        """Read all the setting values within namespace.

        Args:
            namespaces: List of namespaces to filter results by, supports
                simple globbing explained below.
            cancellable: a GCancellable or NULL.

        Returns:
            a value containing all the values, or
                None if not found. If error is not NULL, then the error is
                returned.
        """
    def read_string(self, namespace: _str, key: _str, cancellable: Gio.Cancellable | None = ...) -> _str:
        """Read a setting value as unsigned int within namespace, with key.

        Args:
            namespace: the namespace of the value.
            key: the key of the value.
            cancellable: a GCancellable or NULL.

        Returns:
            the stringint value, or NULL if not found or not
                the right type. If error is not NULL, then the error is returned.
        """
    def read_uint(self, namespace: _str, key: _str, cancellable: Gio.Cancellable | None = ...) -> _int:
        """Read a setting value as unsigned int within namespace, with key.

        Args:
            namespace: the namespace of the value.
            key: the key of the value.
            cancellable: a GCancellable or NULL.

        Returns:
            the uint value, or 0 if not found or not
                the right type. If error is not NULL, then the error is returned.
        """
    def read_value(self, namespace: _str, key: _str, cancellable: Gio.Cancellable | None = ...) -> GLib.Variant:
        """Read a setting value within namespace, with key.

        Args:
            namespace: the namespace of the value.
            key: the key of the value.
            cancellable: a GCancellable or NULL.

        Returns:
            the value, or None if not
                found. If error is not NULL, then the error is returned.
        """

