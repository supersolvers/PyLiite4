    @_overload
    def mount(self, flags: MountMountFlags, mount_operation: MountOperation | None = ..., cancellable: Cancellable | None = ...) -> _Awaitable[_bool]:
        """Mounts a volume. This is an asynchronous operation, and is
        finished by calling Gio.Volume.mount_finish() with the self
        and Gio.AsyncResult returned in the callback.

        Args:
            flags: flags affecting the operation
            mount_operation: a Gio.MountOperation or None to avoid user interaction
