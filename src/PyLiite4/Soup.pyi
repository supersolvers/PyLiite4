    def copy(self) -> HSTSPolicy:
        """Copies self.

        Returns:
            a copy of self
        """
    def equal(self, policy2: HSTSPolicy) -> _bool:
        """Tests if self and policy2 are equal.

        Args:
            policy2: a Soup.HSTSPolicy

        Returns:
            whether the policies are equal.
        """
    def free(self) -> None:
        """Frees self."""
    def get_domain(self) -> _str:
        """Gets self's domain.

        Returns:
            self's domain.
        """
    def get_expires(self) -> GLib.DateTime:
        """Returns the expiration date for self.

        Returns:
            A GLib.DateTime or None if unset
        """
    def get_max_age(self) -> _int:
        """Returns the max age for self.

        Returns:
            Max age in seconds
        """
    def includes_subdomains(self) -> _bool:
        """Gets whether self include its subdomains.

        Returns:
            True if self includes subdomains, False otherwise.
        """
    def is_expired(self) -> _bool:
        """Gets whether self is expired.

        Permanent policies never expire.

        Returns:
            True if self is expired, False otherwise.
        """
    def is_session_policy(self) -> _bool:
        """Gets whether self is a non-permanent, non-expirable session policy.

        See HSTSPolicy.new_session_policy() for details.

        Returns:
            True if self is permanent, False otherwise
        """
    @classmethod
    def new(cls, domain: _str, max_age: _int, include_subdomains: _bool) -> HSTSPolicy:
        """Creates a new HSTSPolicy with the given attributes.

        domain is a domain on which the strict transport security policy
        represented by this object must be enforced.

        max_age is used to set the "expires" attribute on the policy; pass
        Soup.HSTS_POLICY_MAX_AGE_PAST for an already-expired policy, or a
        lifetime in seconds.

        If include_subdomains is True, the strict transport security policy
        must also be enforced on all subdomains of domain.

        Args:
            domain: policy domain or hostname
            max_age: max age of the policy
            include_subdomains: True if the policy applies on subdomains

        Returns:
            a new Soup.HSTSPolicy.
        """
    @classmethod
    def new_from_response(cls, msg: Message) -> HSTSPolicy | None:
