class QOSType(GObject.GEnum):
    """The different types of QoS events that can be given to the
    Gst.Event.new_qos() method.
    """
    OVERFLOW: QOSType
    """The QoS event type that is produced when upstream
       elements are producing data too quickly and the element can't keep up
       processing the data. Upstream should reduce their production rate. This
       type is also used when buffers arrive early or in time.
    """
    UNDERFLOW: QOSType
    """The QoS event type that is produced when upstream
       elements are producing data too slowly and need to speed up their
       production rate.
    """
    THROTTLE: QOSType
    """The QoS event type that is produced when the
       application enabled throttling to limit the data rate.
    """

QUERY_NUM_SHIFT: _int

QUERY_TYPE_BOTH: QueryTypeFlags
"""The same thing as Gst.QueryTypeFlags.UPSTREAM | Gst.QueryTypeFlags.DOWNSTREAM."""

class Query:
    """Queries can be performed on pads (Gst.Pad.query()) and elements
    (Gst.Element.query()). Please note that some queries might need a running
    pipeline to work.

    Queries can be created using the gst_query_new_*() functions.
    Query values can be set using gst_query_set_*(), and parsed using
    gst_query_parse_*() helpers.

    The following example shows how to query the duration of a pipeline:
    ```c
      GstQuery *query;
      gboolean res;
      query = gst_query_new_duration (GST_FORMAT_TIME);
      res = gst_element_query (pipeline, query);
      if (res) {
        gint64 duration;
        gst_query_parse_duration (query, NULL, &duration);
        g_print ("duration = %"GST_TIME_FORMAT, GST_TIME_ARGS (duration));
      } else {
        g_print ("duration query failed...");
      }
      gst_query_unref (query);
    ```
    """
    type: QueryType
    mini_object: MiniObject
    def add_allocation_meta(self, api: _GTypeLike, params: Structure | None = ...) -> None:
        """Add api with params as one of the supported metadata API to self.

        Args:
            api: the metadata API
            params: API specific parameters
        """
    def add_allocation_param(self, allocator: Allocator | None = ..., params: AllocationParams | None = ...) -> None:
        """Add allocator and its params as a supported memory allocator.

        Args:
            allocator: the memory allocator
            params: a Gst.AllocationParams
        """
    def add_allocation_pool(self, pool: BufferPool | None, size: _int, min_buffers: _int, max_buffers: _int) -> None:
        """Set the pool parameters in self.

        Args:
            pool: the Gst.BufferPool
            size: the buffer size
            min_buffers: the min buffers
            max_buffers: the max buffers
        """
    def add_buffering_range(self, start: _int, stop: _int) -> _bool:
        """Set the buffering-ranges array field in self. The current last
        start position of the array should be inferior to start.

        Args:
            start: start position of the range
            stop: stop position of the range

        Returns:
            a #gboolean indicating if the range was added or not.
        """
    def add_scheduling_mode(self, mode: PadMode) -> None:
        """Add mode as one of the supported scheduling modes to self.

        Args:
            mode: a Gst.PadMode
        """
    def find_allocation_meta(self, api: _GTypeLike) -> _tuple[_bool, _int]:
        """Check if self has metadata api set. When this function returns True,
        index will contain the index where the requested API and the parameters
        can be found.

        Args:
            api: the metadata API

        Returns:
            True when api is in the list of metadata.
            index: the index
        """
    def get_n_allocation_metas(self) -> _int:
        """Retrieve the number of values currently stored in the
        meta API array of the query's structure.

        Returns:
            the metadata API array size as a #guint.
        """
    def get_n_allocation_params(self) -> _int:
        """Retrieve the number of values currently stored in the
        allocator params array of the query's structure.

        If no memory allocator is specified, the downstream element can handle
        the default memory allocator. The first memory allocator in the query
        should be generic and allow mapping to system memory, all following
        allocators should be ordered by preference with the preferred one first.

        Returns:
            the allocator array size as a #guint.
        """
    def get_n_allocation_pools(self) -> _int:
        """Retrieve the number of values currently stored in the
        pool array of the query's structure.

        Returns:
            the pool array size as a #guint.
        """
    def get_n_buffering_ranges(self) -> _int:
        """Retrieve the number of values currently stored in the
        buffered-ranges array of the query's structure.

        Returns:
            the range array size as a #guint.
        """
    def get_n_scheduling_modes(self) -> _int:
        """Retrieve the number of values currently stored in the
        scheduling mode array of the query's structure.

        Returns:
            the scheduling mode array size as a #guint.
        """
    def get_structure(self) -> Structure | None:
        """Get the structure of a query.

        Returns:
            the Gst.Structure of the query. The
                structure is still owned by the query and will therefore be freed when the
                query is unreffed.
        """
    def has_scheduling_mode(self, mode: PadMode) -> _bool:
        """Check if self has scheduling mode set.

        > When checking if upstream supports pull mode, it is usually not
        > enough to just check for GST_PAD_MODE_PULL with this function, you
        > also want to check whether the scheduling flags returned by
        > Gst.Query.parse_scheduling() have the seeking flag set (meaning
        > random access is supported, not only sequential pulls).

        Args:
            mode: the scheduling mode

        Returns:
            True when mode is in the list of scheduling modes.
        """
    def has_scheduling_mode_with_flags(self, mode: PadMode, flags: SchedulingFlags) -> _bool:
        """Check if self has scheduling mode set and flags is set in
        query scheduling flags.

        Args:
            mode: the scheduling mode
            flags: Gst.SchedulingFlags

        Returns:
            True when mode is in the list of scheduling modes
                and flags are compatible with query flags.
        """
    def parse_accept_caps(self) -> Caps:
        """Get the caps from self. The caps remains valid as long as self remains
        valid.

        Returns:
            A pointer to the caps
        """
    def parse_accept_caps_result(self) -> _bool | None:
        """Parse the result from self and store in result.

        Returns:
            location for the result
        """
    def parse_allocation(self) -> _tuple[Caps | None, _bool]:
        """Parse an allocation query, writing the requested caps in caps and
