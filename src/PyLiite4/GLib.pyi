class BookmarkFileError(GObject.GEnum):
    """Error codes returned by bookmark file parsing."""
    INVALID_URI: BookmarkFileError
    """URI was ill-formed"""
    INVALID_VALUE: BookmarkFileError
    """a requested field was not found"""
    APP_NOT_REGISTERED: BookmarkFileError
    """a requested application did
        not register a bookmark
    """
    URI_NOT_FOUND: BookmarkFileError
    """a requested URI was not found"""
    READ: BookmarkFileError
    """document was ill formed"""
    UNKNOWN_ENCODING: BookmarkFileError
    """the text being parsed was
        in an unknown encoding
    """
    WRITE: BookmarkFileError
    """an error occurred while writing"""
    FILE_NOT_FOUND: BookmarkFileError
    """requested file was not found"""

