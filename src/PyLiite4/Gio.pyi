    def init_async(self, io_priority: _int, cancellable: Cancellable | None, callback: AsyncReadyCallback | None) -> None: ...
    def init_finish(self, res: AsyncResult) -> _bool:
        """Finishes asynchronous initialization and returns the result.
        See Gio.AsyncInitable.init_async().

        Args:
