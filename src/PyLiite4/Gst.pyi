    def get_last_flow_return(self) -> FlowReturn:
        """Gets the Gst.FlowReturn return from the last data passed by this pad."""
    def get_offset(self) -> _int:
        """Get the offset applied to the running time of self. self has to be a source
        pad.

        Returns:
            the offset.
        """
    def get_pad_template(self) -> PadTemplate | None:
        """Gets the template for self.

        Returns:
            the Gst.PadTemplate from which
                this pad was instantiated, or None if this pad has no
                template.
