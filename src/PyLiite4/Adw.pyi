class FlapFoldPolicy(GObject.GEnum):
    """Describes the possible folding behavior of a Flap widget.

    Deprecated since 1.4: See [the migration guide](migrating-to-breakpoints.html#replace-adwflap)
    """
    NEVER: FlapFoldPolicy
    """Disable folding, the flap cannot reach narrow
      sizes.
    """
    ALWAYS: FlapFoldPolicy
    """Keep the flap always folded."""
    AUTO: FlapFoldPolicy
    """Fold and unfold the flap based on available
      space.
    """

class FlapTransitionType(GObject.GEnum):
    """Describes transitions types of a Flap widget.

    It determines the type of animation when transitioning between children in a
    Flap widget, as well as which areas can be swiped via
    Flap.props.swipe_to_open and Flap.props.swipe_to_close.

    Deprecated since 1.4: See [the migration guide](migrating-to-breakpoints.html#replace-adwflap)
    """
    OVER: FlapTransitionType
    """The flap slides over the content, which is
      dimmed. When folded, only the flap can be swiped.
    """
    UNDER: FlapTransitionType
    """The content slides over the flap. Only the
      content can be swiped.
    """
    SLIDE: FlapTransitionType
    """The flap slides offscreen when hidden,
      neither the flap nor content overlap each other. Both widgets can be
      swiped.
    """

class FoldThresholdPolicy(GObject.GEnum):
    """Determines when Flap and Leaflet will fold.

    Deprecated since 1.4: Stop using `Adw.Leaflet` and `Adw.Flap`
    """
    MINIMUM: FoldThresholdPolicy
    """Folding is based on the minimum size"""
    NATURAL: FoldThresholdPolicy
    """Folding is based on the natural size"""

