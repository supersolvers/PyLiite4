        """

class _StreamProps(_ObjectProps):
    caps: Caps
    stream_flags: StreamFlags
    stream_id: _str
    stream_type: StreamType
    tags: TagList

class Stream(Object):
    """A high-level object representing a single stream. It might be backed, or
    not, by an actual flow of data in a pipeline (Gst.Pad).

    A Gst.Stream does not care about data changes (such as decoding, encoding,
    parsing,...) as long as the underlying data flow corresponds to the same
    high-level flow (ex: a certain audio track).

    A Gst.Stream contains all the information pertinent to a stream, such as
    stream-id, tags, caps, type, ...

    Elements can subclass a Gst.Stream for internal usage (to contain information
    pertinent to streams of data).
    """
    props: _StreamProps  # type: ignore[assignment]
    def __init__(self, *, caps: Caps = ..., stream_flags: StreamFlags = ..., stream_id: _str = ..., stream_type: StreamType = ..., tags: TagList = ..., name: _str = ..., parent: Object = ..., **properties: _Any) -> None: ...
    def get_caps(self) -> Caps | None:
        """Retrieve the caps for self, if any

        Returns:
            The Gst.Caps for self
        """
    def get_stream_flags(self) -> StreamFlags:
        """Retrieve the current stream flags for self

        Returns:
            The Gst.StreamFlags for self
        """
    def get_stream_id(self) -> _str | None:
        """Returns the stream ID of self.

        Returns:
            the stream ID of self. Only valid
                during the lifetime of self.
