class ContentFormats:
    """Used to advertise and negotiate the format of content.

    You will encounter `Gdk.ContentFormats` when interacting with objects
    controlling operations that pass data between different widgets, window
    or application, like Gdk.Drag, Gdk.Drop,
    Gdk.Clipboard or Gdk.ContentProvider.

    GDK supports content in 2 forms: `GObject.Type` and mime type.
    Using `GTypes` is meant only for in-process content transfers. Mime types
    are meant to be used for data passing both in-process and out-of-process.
    The details of how data is passed is described in the documentation of
    the actual implementations. To transform between the two forms,
    Gdk.ContentSerializer and Gdk.ContentDeserializer are used.

    A `Gdk.ContentFormats` describes a set of possible formats content can be
    exchanged in. It is assumed that this set is ordered. `GTypes` are more
    important than mime types. Order between different `GTypes` or mime types
    is the order they were added in, most important first. Functions that
    care about order, such as Gdk.ContentFormats.union(), will describe
    in their documentation how they interpret that order, though in general the
    order of the first argument is considered the primary order of the result,
    followed by the order of further arguments.

    For debugging purposes, the function Gdk.ContentFormats.to_string()
    exists. It will print a comma-separated list of formats from most important
    to least important.

    `Gdk.ContentFormats` is an immutable struct. After creation, you cannot change
    the types it represents. Instead, new `Gdk.ContentFormats` have to be created.
    The Gdk.ContentFormatsBuilder structure is meant to help in this
    endeavor.
    """
    def contain_gtype(self, type: _GTypeLike) -> _bool:
        """Checks if a given `GObject.Type` is part of the given self.

        Args:
            type: the `GObject.Type` to search for

        Returns:
            True if the `GObject.Type` was found
        """
    def contain_mime_type(self, mime_type: _str) -> _bool:
        """Checks if a given mime type is part of the given self.

        Args:
            mime_type: the mime type to search for

        Returns:
            True if the mime_type was found
        """
    def get_gtypes(self) -> _list[GObject.GType] | None:
        """Gets the `GObject.Type`s included in self.

        Note that self may not contain any `GObject.Type`s, in particular when
        they are empty. In that case None will be returned.

        Returns:
            G_TYPE_INVALID-terminated array of types included in self
        """
    def get_mime_types(self) -> _list[_str] | None:
        """Gets the mime types included in self.

        Note that self may not contain any mime types, in particular
        when they are empty. In that case None will be returned.

        Returns:
            NULL-terminated array of interned strings of mime types included
                in self
        """
    def is_empty(self) -> _bool:
        """Returns whether the content formats contain any formats.

        Returns:
            true if self contains no mime types and no GTypes
        """
    def match(self, second: ContentFormats) -> _bool:
        """Checks if self and second have any matching formats.

        Args:
            second: the `Gdk.ContentFormats` to intersect with

        Returns:
            True if a matching format was found.
        """
    def match_gtype(self, second: ContentFormats) -> GObject.GType:
        """Finds the first `GObject.Type` from self that is also contained
        in second.

        If no matching `GObject.Type` is found, G_TYPE_INVALID is returned.

        Args:
            second: the `Gdk.ContentFormats` to intersect with

        Returns:
            The first common `GObject.Type` or G_TYPE_INVALID if none.
        """
    def match_mime_type(self, second: ContentFormats) -> _str | None:
        """Finds the first mime type from self that is also contained
        in second.

        If no matching mime type is found, None is returned.

        Args:
            second: the `Gdk.ContentFormats` to intersect with

        Returns:
            The first common mime type or None if none
        """
    def print_(self, string: GLib.String) -> None:
        """Prints the given self into a string for human consumption.

        The result of this function can later be parsed with
        Gdk.ContentFormats.parse().

        Args:
            string: a `GLib.String` to print into
        """
    def ref(self) -> ContentFormats:
        """Increases the reference count of a `Gdk.ContentFormats` by one.

        Returns:
            the passed in `Gdk.ContentFormats`.
        """
    def to_string(self) -> _str:
        """Prints the given self into a human-readable string.

        The resulting string can be parsed with Gdk.ContentFormats.parse().

        This is a small wrapper around Gdk.ContentFormats.print_()
        to help when debugging.

        Returns:
            a new string
        """
    def union(self, second: ContentFormats) -> ContentFormats:
        """Append all missing types from second to self, in the order
        they had in second.

        Args:
            second: the `Gdk.ContentFormats` to merge from

        Returns:
            a new `Gdk.ContentFormats`
        """
    def union_deserialize_gtypes(self) -> ContentFormats:
        """Add GTypes for mime types in self for which deserializers are
        registered.

        Returns:
            a new `Gdk.ContentFormats`
        """
    def union_deserialize_mime_types(self) -> ContentFormats:
        """Add mime types for GTypes in self for which deserializers are
        registered.

        Returns:
            a new `Gdk.ContentFormats`
        """
    def union_serialize_gtypes(self) -> ContentFormats:
        """Add GTypes for the mime types in self for which serializers are
        registered.

        Returns:
            a new `Gdk.ContentFormats`
        """
    def union_serialize_mime_types(self) -> ContentFormats:
        """Add mime types for GTypes in self for which serializers are
        registered.

        Returns:
            a new `Gdk.ContentFormats`
        """
    def unref(self) -> None:
        """Decreases the reference count of a `Gdk.ContentFormats` by one.

        If the resulting reference count is zero, frees the formats.
        """
    @classmethod
    def new(cls, mime_types: _list[_str] | None = ...) -> ContentFormats:
        """Creates a new `Gdk.ContentFormats` from an array of mime types.

        The mime types must be valid and different from each other or the
        behavior of the return value is undefined. If you cannot guarantee
        this, use Gdk.ContentFormatsBuilder instead.

        Args:
            mime_types: Pointer to an
                array of mime types

        Returns:
            the new `Gdk.ContentFormats`.
        """
    @classmethod
    def new_for_gtype(cls, type: _GTypeLike) -> ContentFormats:
        """Creates a new `Gdk.ContentFormats` for a given `GObject.Type`.

        Args:
            type: a `GObject.Type`

        Returns:
            a new `Gdk.ContentFormats`
        """
    @staticmethod
    def parse(string: _str) -> ContentFormats | None:
        """Parses the given string into `Gdk.ContentFormats` and
        returns the formats.

        Strings printed via Gdk.ContentFormats.to_string()
        can be read in again successfully using this function.

        If string does not describe valid content formats, None
        is returned.

        Args:
            string: the string to parse

        Returns:
            the content formats if string is valid
        """

