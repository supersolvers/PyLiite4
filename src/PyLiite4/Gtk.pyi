class CssSection:
    """Defines a part of a CSS document.

    Because sections are nested into one another, you can use
    CssSection.get_parent() to get the containing region.
    """
    def get_bytes(self) -> GLib.Bytes | None:
        """Gets the bytes that self was parsed from.

        Returns:
            the `GLib.Bytes` from which the `section`
                was parsed
        """
    def get_end_location(self) -> CssLocation:
        """Returns the location in the CSS document where this section ends.

        Returns:
            The end location of
                this section
        """
    def get_file(self) -> Gio.File | None:
        """Gets the file that self was parsed from.

        If no such file exists, for example because the CSS was loaded via
        Gtk.CssProvider.load_from_data(), then `None` is returned.

        Returns:
            the `Gio.File` from which the `section`
                was parsed
        """
    def get_parent(self) -> CssSection | None:
        """Gets the parent section for the given `section`.

        The parent section is the section that contains this `section`. A special
        case are sections of  type `GTK_CSS_SECTION_DOCUMENT`. Their parent will
        either be `None` if they are the original CSS document that was loaded by
        Gtk.CssProvider.load_from_file() or a section of type
        `GTK_CSS_SECTION_IMPORT` if it was loaded with an `@import` rule from
        a different file.

        Returns:
            the parent section
        """
    def get_start_location(self) -> CssLocation:
        """Returns the location in the CSS document where this section starts.

        Returns:
            The start location of
                this section
        """
    def print_(self, string: GLib.String) -> None:
        """Prints the `section` into `string` in a human-readable form.

        This is a form like `gtk.css:32:1-23` to denote line 32, characters
        1 to 23 in the file `gtk.css`.

        Args:
            string: a `GLib.String` to print to
        """
    def ref(self) -> CssSection:
        """Increments the reference count on `section`.

        Returns:
            the CSS section itself.
        """
    def to_string(self) -> _str:
        """Prints the section into a human-readable text form using
        Gtk.CssSection.print_().

        Returns:
            A new string.
        """
    def unref(self) -> None:
        """Decrements the reference count on `section`, freeing the
        structure if the reference count reaches 0.
        """
    @classmethod
    def new(cls, file: Gio.File | None, start: CssLocation, end: CssLocation) -> CssSection:
        """Creates a new `Gtk.CssSection` referring to the section
        in the given `file` from the `start` location to the
        `end` location.

        Args:
            file: The file this section refers to
            start: The start location
            end: The end location

        Returns:
            a new `Gtk.CssSection`
        """
    @classmethod
    def new_with_bytes(cls, file: Gio.File | None, bytes: GLib.Bytes | None, start: CssLocation, end: CssLocation) -> CssSection:
        """Creates a new `Gtk.CssSection` referring to the section
        in the given `file` or the given `bytes` from the `start` location to the
        `end` location.

        Args:
            file: The file this section refers to
            bytes: The bytes this sections refers to
            start: The start location
            end: The end location

        Returns:
            a new `Gtk.CssSection`
        """

