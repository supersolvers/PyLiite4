<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="AdwStatusPage" id="preview">
    <property name="title" translatable="yes">Location</property>
    <property name="description" translatable="yes">Request the user location</property>
    <property name="margin-top">48</property>
    <child>
      <object class="AdwClamp">
        <property name="maximum-size">480</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="halign">center</property>
            <child>
              <object class="GtkListBox">
                <property name="selection-mode">none</property>
                <property name="margin-bottom">18</property>
                <style>
                  <class name="boxed-list"/>
                </style>
                <child>
                  <object class="AdwSpinRow" id="distance_threshold">
                    <property name="title" translatable="yes">Distance Threshold</property>
                    <property name="subtitle" translatable="yes">In meters</property>
                    <property name="wrap">true</property>
                    <property name="value">0</property>
                    <property name="climb-rate">1</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">0</property>
                        <property name="upper">100</property>
                        <property name="value">0</property>
                        <property name="step-increment">1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwSpinRow" id="time_threshold">
                    <property name="title" translatable="yes">Time Threshold</property>
                    <property name="subtitle" translatable="yes">In seconds</property>
                    <property name="value">0</property>
                    <property name="climb-rate">1</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">0</property>
                        <property name="upper">100</property>
                        <property name="value">0</property>
                        <property name="step-increment">1</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="accuracy_button">
                    <property name="title" translatable="yes">Accuracy</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes" context="Accuracy">Exact</item>
                          <item translatable="yes" context="Accuracy">Street</item>
                          <item translatable="yes" context="Accuracy">Neighborhood</item>
                          <item translatable="yes" context="Accuracy">City</item>
                          <item translatable="yes" context="Accuracy">Country</item>
                          <item translatable="yes" context="Accuracy">None</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="halign">center</property>
                <property name="spacing">30</property>
                <property name="margin-bottom">24</property>
                <child>
                  <object class="GtkButton" id="start">
                    <property name="label" translatable="yes">Start Session</property>
                    <property name="halign">center</property>
                    <style>
                      <class name="suggested-action"/>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="close">
                    <property name="label" translatable="yes">Close Session</property>
                    <property name="halign">center</property>
                    <property name="sensitive">false</property>
                    <style>
                      <class name="destructive-action"/>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkRevealer" id="revealer">
                <property name="transition-duration">300</property>
                <property name="transition-type">slide-up</property>
                <child>
                  <object class="GtkListBox">
                    <property name="selection-mode">none</property>
                    <property name="margin-bottom">18</property>
                    <style>
                      <class name="boxed-list"/>
                    </style>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Latitude</property>
                        <property name="subtitle" translatable="yes">In degrees</property>
                        <child>
                          <object class="GtkLabel" id="latitude">
                            <property name="label" translatable="yes">unknown</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Longitude</property>
                        <property name="subtitle" translatable="yes">In degrees</property>
                        <child>
                          <object class="GtkLabel" id="longitude">
                            <property name="label" translatable="yes">unknown</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Accuracy</property>
                        <property name="subtitle" translatable="yes">In meters</property>
                        <child>
                          <object class="GtkLabel" id="accuracy">
                            <property name="label" translatable="yes">unknown</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Altitude</property>
                        <property name="subtitle" translatable="yes">In meters</property>
                        <child>
                          <object class="GtkLabel" id="altitude">
                            <property name="label" translatable="yes">unknown</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Speed</property>
                        <property name="subtitle" translatable="yes">In meters per second</property>
                        <child>
                          <object class="GtkLabel" id="speed">
                            <property name="label" translatable="yes">unknown</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Heading</property>
                        <property name="subtitle" translatable="yes">In degrees, clockwise</property>
                        <child>
                          <object class="GtkLabel" id="heading">
                            <property name="label" translatable="yes">unknown</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Description</property>
                        <child>
                          <object class="GtkLabel" id="description">
                            <property name="label" translatable="yes">unknown</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow">
                        <property name="title" translatable="yes">Timestamp</property>
                        <child>
                          <object class="GtkLabel" id="timestamp">
                            <property name="label" translatable="yes">unknown</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">API Reference</property>
                <property name="uri">https://libportal.org/method.Portal.location_monitor_start.html</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
