        """Gets whether the sorter ignores case differences.

        Returns:
            True if self is ignoring case differences
        """
    def set_collation(self, collation: Collation) -> None:
        """Sets the collation method to use for sorting.

        Args:
            collation: the collation method
        """
    def set_expression(self, expression: Expression | None = ...) -> None:
        """Sets the expression that is evaluated to obtain strings from items.

        The expression must have the type G_TYPE_STRING.

        Args:
            expression: a `Gtk.Expression`
