    def new_from_template(cls, name: _str | None, target: Pad, templ: PadTemplate) -> Pad | None:
        """Create a new ghostpad with target as the target. The direction will be taken
        from the target pad. The template used on the ghostpad will be template.

        Will ref the target.

        Args:
            name: the name of the new pad, or None to assign a default name.
            target: the pad to ghost.
            templ: the Gst.PadTemplate to use on the ghostpad.

        Returns:
            a new Gst.Pad, or None in
