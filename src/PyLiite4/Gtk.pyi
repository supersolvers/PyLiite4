    def accessible_description(self) -> _str:
        """The accessible description to set on the listitem."""
    @accessible_description.setter
    def accessible_description(self, value: _str) -> None: ...
    @property
    def accessible_label(self) -> _str:
        """The accessible label to set on the listitem."""
    @accessible_label.setter
    def accessible_label(self, value: _str) -> None: ...
    @property
    def activatable(self) -> _bool:
        """If the item can be activated by the user."""
    @activatable.setter
    def activatable(self, value: _bool) -> None: ...
    @property
    def child(self) -> Widget:
        """Widget used for display."""
    @child.setter
    def child(self, value: Widget) -> None: ...
    @property
    def focusable(self) -> _bool:
        """If the item can be focused with the keyboard."""
    @focusable.setter
    def focusable(self, value: _bool) -> None: ...
    @property
    def item(self) -> GObject.Object:
        """Displayed item."""
    @property
    def position(self) -> _int:
        """Position of the item."""
    @property
    def selectable(self) -> _bool:
        """If the item can be selected by the user."""
    @selectable.setter
    def selectable(self, value: _bool) -> None: ...
    @property
    def selected(self) -> _bool:
        """If the item is currently selected."""

