class _EmblemProps(GObject._ObjectProps):
    icon: GObject.Object
    origin: EmblemOrigin

class Emblem(GObject.Object, Icon):
    """`Gio.Emblem` is an implementation of Gio.Icon that supports
    having an emblem, which is an icon with additional properties.
    It can than be added to a Gio.EmblemedIcon.

    Currently, only metainformation about the emblem's origin is
    supported. More may be added in the future.
    """
    props: _EmblemProps  # type: ignore[assignment]
    def __init__(self, *, icon: GObject.Object = ..., origin: EmblemOrigin = ..., **properties: _Any) -> None: ...
    def get_icon(self) -> Icon:
        """Gives back the icon from self.

        Returns:
            a Gio.Icon. The returned object belongs to
                the emblem and should not be modified or freed.
        """
    def get_origin(self) -> EmblemOrigin:
        """Gets the origin of the emblem.

        Returns:
            the origin of the emblem
        """
    @classmethod
    def new(cls, icon: Icon) -> Emblem:
        """Creates a new emblem for icon.

        Args:
            icon: a GIcon containing the icon.

        Returns:
            a new Gio.Emblem.
        """
    @classmethod
    def new_with_origin(cls, icon: Icon, origin: EmblemOrigin) -> Emblem:
        """Creates a new emblem for icon.

        Args:
            icon: a GIcon containing the icon.
            origin: a GEmblemOrigin enum defining the emblem's origin

        Returns:
            a new Gio.Emblem.
        """
    @property
    def icon(self) -> GObject.Object:
        """The actual icon of the emblem."""
    @property
    def origin(self) -> EmblemOrigin:
        """The origin the emblem is derived from."""

