    MINIMIZED: ToplevelState
    """the surface is minimized"""
    MAXIMIZED: ToplevelState
    """the surface is maximized"""
    STICKY: ToplevelState
    """the surface is sticky"""
    FULLSCREEN: ToplevelState
    """the surface is maximized without decorations"""
    ABOVE: ToplevelState
    """the surface is kept above other surfaces"""
    BELOW: ToplevelState
    """the surface is kept below other surfaces"""
    FOCUSED: ToplevelState
    """the surface is presented as focused (with active decorations)"""
    TILED: ToplevelState
    """the surface is in a tiled state"""
    TOP_TILED: ToplevelState
    """whether the top edge is tiled"""
    TOP_RESIZABLE: ToplevelState
    """whether the top edge is resizable"""
    RIGHT_TILED: ToplevelState
    """whether the right edge is tiled"""
    RIGHT_RESIZABLE: ToplevelState
    """whether the right edge is resizable"""
    BOTTOM_TILED: ToplevelState
    """whether the bottom edge is tiled"""
    BOTTOM_RESIZABLE: ToplevelState
    """whether the bottom edge is resizable"""
    LEFT_TILED: ToplevelState
    """whether the left edge is tiled"""
    LEFT_RESIZABLE: ToplevelState
    """whether the left edge is resizable"""
    SUSPENDED: ToplevelState
    """The surface is not visible to the user."""

