    def get_buffer(self) -> Buffer:
        """Returns:
            the GtkSource.Buffer to load the contents into.
        """
    def get_compression_type(self) -> CompressionType:
        """Returns:
            the detected compression type.
        """
    def get_encoding(self) -> Encoding:
        """Returns:
            the detected file encoding.
        """
    def get_file(self) -> File:
        """Returns:
            the GtkSource.File.
        """
    def get_input_stream(self) -> Gio.InputStream | None:
        """Returns:
            the Gio.InputStream to load, or None
                if a Gio.File is used.
        """
    def get_location(self) -> Gio.File | None:
        """Returns:
            the Gio.File to load, or None
                if an input stream is used.
        """
    def get_newline_type(self) -> NewlineType:
        """Returns:
            the detected newline type.
        """
    def load_async(self, io_priority: _int, cancellable: Gio.Cancellable | None = ..., progress_callback: Gio.FileProgressCallback | None = ..., progress_callback_data: _Any = ..., callback: Gio.AsyncReadyCallback | None = ...) -> None:
        """Loads asynchronously the file or input stream contents into the Buffer.

        See the Gio.AsyncResult documentation to know how to use this
        function.

        Args:
            io_priority: the I/O priority of the request. E.g. GLib.PRIORITY_LOW,
                GLib.PRIORITY_DEFAULT or GLib.PRIORITY_HIGH.
            cancellable: optional Gio.Cancellable object, None to ignore.
            progress_callback: function to call back with progress information, or None if progress
                information is not needed.
            progress_callback_data: user data to pass to progress_callback.
            callback: a Gio.AsyncReadyCallback to call when the request is
                satisfied.
        """
