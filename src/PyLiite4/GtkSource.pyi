class Map(View):
    """Widget that displays a map for a specific View.

    `GtkSource.Map` is a widget that maps the content of a View into
    a smaller view so the user can have a quick overview of the whole document.

    This works by connecting a View to to the `GtkSource.Map` using
    the Map.props.view property or Map.set_view().

    `GtkSource.Map` is a View object. This means that you can add a
    GutterRenderer to a gutter in the same way you would for a
    View. One example might be a GutterRenderer that shows
    which lines have changed in the document.

    Additionally, it is desirable to match the font of the `GtkSource.Map` and
    the View used for editing. Therefore, Map.props.font_desc
    should be used to set the target font. You will need to adjust this to the
    desired font size for the map. A 1pt font generally seems to be an
    appropriate font size. "Monospace 1" is the default. See
    Pango.FontDescription.set_size() for how to alter the size of an existing
    Pango.FontDescription.

    When FontConfig is available, `GtkSource.Map` will try to use a bundled
    "block" font to make the map more legible.
    """
    props: _MapProps  # type: ignore[assignment]
    def __init__(self, *, font_desc: Pango.FontDescription = ..., view: View = ..., auto_indent: _bool = ..., background_pattern: BackgroundPatternType = ..., enable_snippets: _bool = ..., highlight_current_line: _bool = ..., indent_on_tab: _bool = ..., indent_width: _int = ..., indenter: Indenter = ..., insert_spaces_instead_of_tabs: _bool = ..., right_margin_position: _int = ..., show_line_marks: _bool = ..., show_line_numbers: _bool = ..., show_right_margin: _bool = ..., smart_backspace: _bool = ..., smart_home_end: SmartHomeEndType = ..., tab_width: _int = ..., accessible_role: _Any = ..., hadjustment: _Any = ..., hscroll_policy: _Any = ..., vadjustment: _Any = ..., vscroll_policy: _Any = ..., accepts_tab: _Any = ..., bottom_margin: _Any = ..., buffer: _Any = ..., cursor_visible: _Any = ..., editable: _Any = ..., extra_menu: _Any = ..., im_module: _Any = ..., indent: _Any = ..., input_hints: _Any = ..., input_purpose: _Any = ..., justification: _Any = ..., left_margin: _Any = ..., monospace: _Any = ..., overwrite: _Any = ..., pixels_above_lines: _Any = ..., pixels_below_lines: _Any = ..., pixels_inside_wrap: _Any = ..., right_margin: _Any = ..., tabs: _Any = ..., top_margin: _Any = ..., wrap_mode: _Any = ..., can_focus: _Any = ..., can_target: _Any = ..., css_classes: _Any = ..., css_name: _Any = ..., cursor: _Any = ..., focus_on_click: _Any = ..., focusable: _Any = ..., halign: _Any = ..., has_tooltip: _Any = ..., height_request: _Any = ..., hexpand: _Any = ..., hexpand_set: _Any = ..., layout_manager: _Any = ..., limit_events: _Any = ..., margin_bottom: _Any = ..., margin_end: _Any = ..., margin_start: _Any = ..., margin_top: _Any = ..., name: _Any = ..., opacity: _Any = ..., overflow: _Any = ..., receives_default: _Any = ..., sensitive: _Any = ..., tooltip_markup: _Any = ..., tooltip_text: _Any = ..., valign: _Any = ..., vexpand: _Any = ..., vexpand_set: _Any = ..., visible: _Any = ..., width_request: _Any = ..., **properties: _Any) -> None: ...
