    """Glyphs stand upright (default)"""
    EAST: Gravity
    """Glyphs are rotated 90 degrees counter-clockwise."""
    NORTH: Gravity
    """Glyphs are upside-down."""
    WEST: Gravity
    """Glyphs are rotated 90 degrees clockwise."""
    AUTO: Gravity
