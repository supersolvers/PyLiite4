        Gst.Event.parse_stream().

        Returns:
            the current Gst.Stream for self, or None.
                unref the returned stream when no longer needed.
        """
    def get_stream_id(self) -> _str | None:
        """Returns the current stream-id for the self, or None if none has been
        set yet, i.e. the pad has not received a stream-start event yet.

        This is a convenience wrapper around Gst.Pad.get_sticky_event() and
        Gst.Event.parse_stream_start().

