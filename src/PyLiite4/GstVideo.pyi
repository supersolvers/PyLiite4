class VideoColorRange(GObject.GEnum):
    """Possible color range values. These constants are defined for 8 bit color
    values and can be scaled for other bit depths.
    """
    UNKNOWN: VideoColorRange
    """unknown range"""
    @staticmethod
    def offsets(range: VideoColorRange, info: VideoFormatInfo) -> _tuple[_list[_int], _list[_int]]:
        """Compute the offset and scale values for each component of info. For each
        component, (c[i] - offset[i]) / scale[i] will scale the component c[i] to the
        range [0.0 .. 1.0].

        The reverse operation (c[i] * scale[i]) + offset[i] can be used to convert
        the component values in range [0.0 .. 1.0] back to their representation in
        info and range.

        Args:
            range: a GstVideo.VideoColorRange
            info: a GstVideo.VideoFormatInfo

        Returns:
            offset: output offsets
            scale: output scale
        """

