    def get_item_link(self, item_index: _int, link: _str) -> MenuModel | None:
        """Queries the item at position item_index in self for the link
        specified by link.

        If the link exists, the linked Gio.MenuModel is returned.  If the link
        does not exist, None is returned.

        Args:
            item_index: the index of the item
            link: the link to query

        Returns:
            the linked Gio.MenuModel, or None
        """
    def get_n_items(self) -> _int:
        """Query the number of items in self.

        Returns:
            the number of items
        """
    def is_mutable(self) -> _bool:
        """Queries if self is mutable.

        An immutable Gio.MenuModel will never emit the Gio.MenuModel.items_changed
