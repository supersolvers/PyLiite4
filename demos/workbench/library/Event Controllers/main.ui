<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="event_controllers">
    <property name="title" translatable="yes">Event Controllers</property>
    <property name="description" translatable="yes">Ancillary Objects which responds to events</property>
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <property name="spacing">36</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">EventControllerKey Example</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="ctrl_button">
                <property name="label" translatable="yes">Ctrl + Click to Activate</property>
                <property name="width-request">200</property>
                <property name="halign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">GestureClick Example</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="halign">center</property>
                <property name="homogeneous">true</property>
                <style>
                  <class name="linked"/>
                </style>
                <child>
                  <object class="GtkButton" id="primary_button">
                    <property name="label" translatable="yes">Left</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="middle_button">
                    <property name="label" translatable="yes">Middle</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="secondary_button">
                    <property name="label" translatable="yes">Right</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="halign">center</property>
            <property name="valign">start</property>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">GestureSwipe Example</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkStackSwitcher">
                <property name="stack">stack</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="height-request">256</property>
                <property name="width-request">256</property>
                <property name="halign">center</property>
                <child>
                  <object class="GtkStack" id="stack">
                    <property name="transition-type">slide-left-right</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="title" translatable="yes">Start</property>
                        <property name="name">stack_picture_1</property>
                        <property name="child">
                          <object class="GtkPicture" id="stack_picture_1">
                            <property name="can-shrink">true</property>
                            <property name="content-fit">scale-down</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="title" translatable="yes">Finish</property>
                        <property name="name">stack_picture_2</property>
                        <property name="child">
                          <object class="GtkPicture" id="stack_picture_2">
                            <property name="can-shrink">true</property>
                            <property name="content-fit">scale-down</property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label" translatable="yes">Swipe the picture left or right</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="halign">center</property>
            <property name="valign">center</property>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">Event Controller Key API Reference</property>
                <property name="uri">https://docs.gtk.org/gtk4/class.EventControllerKey.html</property>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">Gesture Click API Reference</property>
                <property name="uri">https://docs.gtk.org/gtk4/class.GestureClick.html</property>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">Gesture Swipe API Reference</property>
                <property name="uri">https://docs.gtk.org/gtk4/class.GestureSwipe.html</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
