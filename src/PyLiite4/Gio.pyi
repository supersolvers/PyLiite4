class FileMonitor(GObject.Object):
    """Monitors a file or directory for changes.

    To obtain a `Gio.FileMonitor` for a file or directory, use
    Gio.File.monitor(), Gio.File.monitor_file(), or
    Gio.File.monitor_directory().

    To get informed about changes to the file or directory you are
    monitoring, connect to the Gio.FileMonitor.changed signal. The
    signal will be emitted in the thread-default main context (see
    GLib.MainContext.push_thread_default()) of the thread that the monitor
    was created in (though if the global default main context is blocked, this
    may cause notifications to be blocked even if the thread-default
    context is still running).
    """
    props: _FileMonitorProps  # type: ignore[assignment]
    def __init__(self, *, rate_limit: _int = ..., **properties: _Any) -> None: ...
    @property
    def changed(self) -> _BoundSignal[_Callable[[FileMonitor, File, File | None, FileMonitorEvent], None]]:
        """Emitted when file has been changed.

        If using Gio.FileMonitorFlags.WATCH_MOVES on a directory monitor, and
        the information is available (and if supported by the backend),
        event_type may be Gio.FileMonitorEvent.RENAMED,
        Gio.FileMonitorEvent.MOVED_IN or Gio.FileMonitorEvent.MOVED_OUT.

        In all cases file will be a child of the monitored directory.  For
        renames, file will be the old name and other_file is the new
        name.  For "moved in" events, file is the name of the file that
        appeared and other_file is the old name that it was moved from (in
        another directory).  For "moved out" events, file is the name of
        the file that used to be in this directory and other_file is the
        name of the file at its new location.

        It makes sense to treat Gio.FileMonitorEvent.MOVED_IN as
        equivalent to Gio.FileMonitorEvent.CREATED and
        Gio.FileMonitorEvent.MOVED_OUT as equivalent to
        Gio.FileMonitorEvent.DELETED, with extra information.
        Gio.FileMonitorEvent.RENAMED is equivalent to a delete/create
        pair.  This is exactly how the events will be reported in the case
        that the Gio.FileMonitorFlags.WATCH_MOVES flag is not in use.

        If using the deprecated flag Gio.FileMonitorFlags.SEND_MOVED flag and event_type is
        Gio.FileMonitorEvent.MOVED, file will be set to a Gio.File containing the
        old path, and other_file will be set to a Gio.File containing the new path.

        In all the other cases, other_file will be set to #NULL.
        """
    def cancel(self) -> _bool:
        """Cancels a file monitor.

        Returns:
            always True
        """
    def emit_event(self, child: File, other_file: File | None, event_type: FileMonitorEvent) -> None:
        """Emits the Gio.FileMonitor.changed signal if a change
        has taken place. Should be called from file monitor
        implementations only.

        Implementations are responsible to call this method from the
        thread-default main context (see GLib.MainContext.push_thread_default())
        of the thread that the monitor was created in.

        Args:
            child: a Gio.File.
            other_file: a Gio.File, or None.
            event_type: a set of Gio.FileMonitorEvent flags.
        """
    def is_cancelled(self) -> _bool:
        """Returns whether the monitor is canceled.

        Returns:
            True if monitor is canceled. False otherwise.
        """
    def set_rate_limit(self, limit_msecs: _int) -> None:
        """Sets the rate limit to which the self will report
        consecutive change events to the same file.

        Args:
            limit_msecs: a non-negative integer with the limit in milliseconds
                to poll for changes
        """
    def do_cancel(self) -> _bool:
        """The virtual method behind cancel(), for subclasses to override."""
    def do_changed(self, file: File, other_file: File, event_type: FileMonitorEvent) -> None: ...
    @property
    def cancelled(self) -> _bool:
        """Whether the monitor has been cancelled."""
    @property
    def rate_limit(self) -> _int:
        """The limit of the monitor to watch for changes, in milliseconds."""
    @rate_limit.setter
    def rate_limit(self, value: _int) -> None: ...

