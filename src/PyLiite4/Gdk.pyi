class MemoryTextureBuilder(GObject.Object):
    """Constructs Gdk.Texture objects from system memory provided
    via GLib.Bytes.

    The operation is quite simple: Create a texture builder, set all the necessary
    properties - keep in mind that the properties Gdk.MemoryTextureBuilder.props.bytes,
    Gdk.MemoryTextureBuilder.props.stride, Gdk.MemoryTextureBuilder.props.width,
    and Gdk.MemoryTextureBuilder.props.height are mandatory - and then call
    Gdk.MemoryTextureBuilder.build() to create the new texture.

    `Gdk.MemoryTextureBuilder` can be used for quick one-shot construction of
    textures as well as kept around and reused to construct multiple textures.
    """
    props: _MemoryTextureBuilderProps  # type: ignore[assignment]
    def __init__(self, *, bytes: GLib.Bytes = ..., color_state: ColorState = ..., format: MemoryFormat = ..., height: _int = ..., stride: _int = ..., update_region: _cairo.Region = ..., update_texture: Texture = ..., width: _int = ..., **properties: _Any) -> None: ...
    def build(self) -> Texture:
        """Builds a new `Gdk.Texture` with the values set up in the builder.

        Note that it is a programming error to call this function if any mandatory
        property has not been set.

        It is possible to call this function multiple times to create multiple textures,
        possibly with changing properties in between.

        Returns:
            a newly built `Gdk.Texture`
        """
    def get_bytes(self) -> GLib.Bytes | None:
        """Gets the bytes previously set via Gdk.MemoryTextureBuilder.set_bytes()
        or None if none was set.

        Returns:
            The bytes
        """
    def get_color_state(self) -> ColorState:
        """Gets the colorstate previously set via Gdk.MemoryTextureBuilder.set_color_state().

        Returns:
            The colorstate
        """
    def get_format(self) -> MemoryFormat:
        """Gets the format previously set via Gdk.MemoryTextureBuilder.set_format().

        Returns:
            The format
        """
    def get_height(self) -> _int:
        """Gets the height previously set via Gdk.MemoryTextureBuilder.set_height()
        or 0 if the height wasn't set.

        Returns:
            The height
        """
    def get_offset(self, plane: _int) -> _int:
        """Gets the offset previously set via Gdk.MemoryTextureBuilder.set_offset().

        Args:
            plane: a plane

        Returns:
            The offset associated to a plane
        """
    def get_stride(self) -> _int:
        """Gets the stride previously set via Gdk.MemoryTextureBuilder.set_stride().

        Returns:
            the stride
        """
    def get_stride_for_plane(self, plane: _int) -> _int:
        """Gets the stride previously set via Gdk.MemoryTextureBuilder.set_stride_for_plane().

        Args:
            plane: a plane

        Returns:
            The stride associated to a plane
        """
    def get_update_region(self) -> _cairo.Region | None:
        """Gets the region previously set via Gdk.MemoryTextureBuilder.set_update_region()
