        Returns:
            a newly allocated UTF-8 string containing the
                resource’s URI or None. Use GLib.free() when done using it.
        """
    def get_visited(self) -> GLib.DateTime:
        """Gets the time when the meta-data
        for the resource was last visited.

        Returns:
            a `GLib.DateTime` for the time
                when the resource was last visited
        """
    def has_application(self, app_name: _str) -> _bool:
        """Checks whether an application registered this resource using app_name.

        Args:
            app_name: a string containing an application name

        Returns:
