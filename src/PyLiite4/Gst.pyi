        the pipeline run as fast as possible.

        MT safe.

        Args:
            clock: the clock to use
        """
    @classmethod
    def new(cls, name: _str | None = ...) -> Element:
        """Create a new pipeline with the given name.

        Args:
            name: name of new pipeline

        Returns:
            newly created GstPipeline

                MT safe.
        """
    @property
    def auto_flush_bus(self) -> _bool:
        """Whether or not to automatically flush all messages on the
        pipeline's bus when going from READY to NULL state. Please see
        Gst.Pipeline.set_auto_flush_bus() for more information on this option.
        """
    @auto_flush_bus.setter
    def auto_flush_bus(self, value: _bool) -> None: ...
    @property
    def delay(self) -> _int:
        """The expected delay needed for elements to spin up to the
        PLAYING state expressed in nanoseconds.
        see Gst.Pipeline.set_delay() for more information on this option.
        """
    @delay.setter
    def delay(self, value: _int) -> None: ...
    @property
    def latency(self) -> _int:
        """Latency to configure on the pipeline. See Gst.Pipeline.set_latency()."""
    @latency.setter
    def latency(self, value: _int) -> None: ...

