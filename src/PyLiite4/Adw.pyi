        """Gets the child widget of self.

        Returns:
            the child widget of self
        """
    def set_child(self, child: Gtk.Widget | None = ...) -> None:
        """Sets the child widget of self.

        Args:
            child: the child widget
        """
    @classmethod
    def new(cls) -> Gtk.Widget:
        """Creates a new `Adw.ToastOverlay`.

        Returns:
            the new created `Adw.ToastOverlay`
        """
    @property
    def child(self) -> Gtk.Widget:
        """The child widget."""
    @child.setter
    def child(self, value: Gtk.Widget) -> None: ...
    @property
    def accessible_role(self) -> _Any: ...
    @accessible_role.setter
