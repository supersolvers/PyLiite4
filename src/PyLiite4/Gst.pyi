    @staticmethod
    def id_compare_func(id1: _Any = ..., id2: _Any = ...) -> _int:
        """Compares the two Gst.ClockID instances. This function can be used
        as a GCompareFunc when sorting ids.

        Args:
            id1: A Gst.ClockID
            id2: A Gst.ClockID to compare with

        Returns:
            negative value if `a < b`; zero if `a = b`; positive value if `a > b`
        """
    @staticmethod
    def id_get_clock(id: ClockID) -> Clock | None:
        """This function returns the underlying clock.

        Args:
            id: a Gst.ClockID

        Returns:
            a Gst.Clock or None when the
                underlying clock has been freed.
        """
    @staticmethod
    def id_get_time(id: ClockID) -> ClockTime:
        """Gets the time of the clock ID

        Args:
            id: The Gst.ClockID to query

        Returns:
            the time of the given clock id.
        """
    @staticmethod
    def id_ref(id: ClockID) -> ClockID:
        """Increases the refcount of given id.

        Args:
            id: The Gst.ClockID to ref

        Returns:
            The same Gst.ClockID with increased refcount.
        """
    @staticmethod
    def id_unref(id: ClockID) -> None:
        """Unrefs given id. When the refcount reaches 0 the
        Gst.ClockID will be freed.

        Args:
            id: The Gst.ClockID to unref
        """
    @staticmethod
    def id_unschedule(id: ClockID) -> None:
