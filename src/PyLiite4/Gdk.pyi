class DmabufFormats:
    """Provides information about supported DMA buffer formats.

    You can query whether a given format is supported with
    Gdk.DmabufFormats.contains() and you can iterate
    over the list of all supported formats with
    Gdk.DmabufFormats.get_n_formats() and
    Gdk.DmabufFormats.get_format().

    The list of supported formats is sorted by preference,
    with the best formats coming first.

    The list may contains (format, modifier) pairs where the modifier
    is `DMA_FORMAT_MOD_INVALID`, indicating that **_implicit modifiers_**
    may be used with this format.

    See Gdk.DmabufTextureBuilder for more information
    about DMA buffers.

    Note that DMA buffers only exist on Linux.
    """
    def contains(self, fourcc: _int, modifier: _int) -> _bool:
        """Returns whether a given format is contained in self.

        Args:
            fourcc: a format code
            modifier: a format modifier

        Returns:
            `True` if the format specified by the arguments
                is part of self
        """
    def equal(self, formats2: DmabufFormats | None = ...) -> _bool:
        """Returns whether self and formats2 contain the
        same dmabuf formats, in the same order.

        Args:
            formats2: another `Gdk.DmabufFormats`

        Returns:
            `True` if self and formats2 are equal
        """
    def get_format(self, idx: _int) -> _tuple[_int, _int]:
        """Gets the fourcc code and modifier for a format
        that is contained in self.

        Args:
            idx: the index of the format to return

        Returns:
            fourcc: return location for the format code
            modifier: return location for the format modifier
        """
    def get_n_formats(self) -> _int:
        """Returns the number of formats that the self object
        contains.

        Note that DMA buffers are a Linux concept, so on other
        platforms, Gdk.DmabufFormats.get_n_formats() will
        always return zero.

        Returns:
            the number of formats
        """
    def ref(self) -> DmabufFormats:
        """Increases the reference count of self.

        Returns:
            the passed-in object
        """
    def unref(self) -> None:
        """Decreases the reference count of self.

        When the reference count reaches zero,
        the object is freed.
        """

