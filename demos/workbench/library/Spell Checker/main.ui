<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <requires lib="gtksourceview" version="5.0"/>
  <object class="AdwStatusPage" id="spell_checker">
    <property name="title" translatable="yes">Spell Checker</property>
    <property name="description" translatable="yes">Simple spell checker using libspelling</property>
    <property name="child">
      <object class="GtkBox">
        <property name="spacing">12</property>
        <property name="orientation">vertical</property>
        <property name="halign">center</property>
        <child>
          <object class="GtkScrolledWindow" id="scrolled_window">
            <property name="height-request">100</property>
            <property name="width-request">400</property>
            <property name="has-frame">true</property>
            <property name="child">
              <object class="GtkTextView" id="text_view">
                <property name="top-margin">6</property>
                <property name="bottom-margin">6</property>
                <property name="left-margin">12</property>
                <property name="right-margin">12</property>
                <property name="buffer">
                  <object class="GtkSourceBuffer" id="buffer">
                    <property name="text" translatable="yes">This is incorrent text. 
Right click mistakes to correct them.</property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">Documentation</property>
            <property name="uri">https://gnome.pages.gitlab.gnome.org/libspelling/libspelling-1/</property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
