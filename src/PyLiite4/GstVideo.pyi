class VideoTransferFunction(GObject.GEnum):
    """The video transfer function defines the formula for converting between
    non-linear RGB (R'G'B') and linear RGB
    """
    UNKNOWN: VideoTransferFunction
    """unknown transfer function"""
    GAMMA10: VideoTransferFunction
    """linear RGB, gamma 1.0 curve"""
    GAMMA18: VideoTransferFunction
    """Gamma 1.8 curve"""
    GAMMA20: VideoTransferFunction
    """Gamma 2.0 curve"""
    GAMMA22: VideoTransferFunction
    """Gamma 2.2 curve"""
    BT709: VideoTransferFunction
    """Gamma 2.2 curve with a linear segment in the lower
                              range, also ITU-R BT470M / ITU-R BT1700 625 PAL &
                              SECAM / ITU-R BT1361
    """
    SMPTE240M: VideoTransferFunction
    """Gamma 2.2 curve with a linear segment in the
                                  lower range
    """
    SRGB: VideoTransferFunction
    """Gamma 2.4 curve with a linear segment in the lower
                             range. IEC 61966-2-1 (sRGB or sYCC)
    """
    GAMMA28: VideoTransferFunction
    """Gamma 2.8 curve, also ITU-R BT470BG"""
    LOG100: VideoTransferFunction
    """Logarithmic transfer characteristic
                                100:1 range
    """
    LOG316: VideoTransferFunction
    """Logarithmic transfer characteristic
                                316.22777:1 range (100 * sqrt(10) : 1)
    """
    BT2020_12: VideoTransferFunction
    """Gamma 2.2 curve with a linear segment in the lower
                                   range. Used for BT.2020 with 12 bits per
                                   component. Since: 1.6
    """
    ADOBERGB: VideoTransferFunction
    """Gamma 2.19921875. Since: 1.8"""
    BT2020_10: VideoTransferFunction
    """Rec. ITU-R BT.2020-2 with 10 bits per component.
                                   (functionally the same as the values
                                   GST_VIDEO_TRANSFER_BT709 and GST_VIDEO_TRANSFER_BT601).
                                   Since: 1.18
    """
    SMPTE2084: VideoTransferFunction
    """SMPTE ST 2084 for 10, 12, 14, and 16-bit systems.
                                   Known as perceptual quantization (PQ)
                                   Since: 1.18
    """
    ARIB_STD_B67: VideoTransferFunction
    """Association of Radio Industries and Businesses (ARIB)
                                      STD-B67 and Rec. ITU-R BT.2100-1 hybrid loggamma (HLG) system
                                      Since: 1.18
    """
    BT601: VideoTransferFunction
    """also known as SMPTE170M / ITU-R BT1358 525 or 625 / ITU-R BT1700 NTSC"""
    @staticmethod
    def decode(func: VideoTransferFunction, val: _float) -> _float:
        """Convert val to its gamma decoded value. This is the inverse operation of
        GstVideo.video_color_transfer_encode().

        For a non-linear value L' in the range [0..1], conversion to the linear
        L is in general performed with a power function like:

        ```
           L = L' ^ gamma
        ```

        Depending on func, different formulas might be applied. Some formulas
        encode a linear segment in the lower range.

        Args:
            func: a GstVideo.VideoTransferFunction
            val: a value

        Returns:
            the gamma decoded value of val
        """
    @staticmethod
    def encode(func: VideoTransferFunction, val: _float) -> _float:
        """Convert val to its gamma encoded value.

        For a linear value L in the range [0..1], conversion to the non-linear
        (gamma encoded) L' is in general performed with a power function like:

        ```
           L' = L ^ (1 / gamma)
        ```

        Depending on func, different formulas might be applied. Some formulas
        encode a linear segment in the lower range.

        Args:
            func: a GstVideo.VideoTransferFunction
            val: a value

        Returns:
            the gamma encoded value of val
        """
    @staticmethod
    def from_iso(value: _int) -> VideoTransferFunction:
        """Converts the value to the GstVideo.VideoTransferFunction
        The transfer characteristics (TransferCharacteristics) value is
        defined by "ISO/IEC 23001-8 Section 7.2 Table 3"
        and "ITU-T H.273 Table 3".
        "H.264 Table E-4" and "H.265 Table E.4" share the identical values.

        Args:
            value: a ITU-T H.273 transfer characteristics value

        Returns:
            the matched GstVideo.VideoTransferFunction
        """
    @staticmethod
    def is_equivalent(from_func: VideoTransferFunction, from_bpp: _int, to_func: VideoTransferFunction, to_bpp: _int) -> _bool:
        """Returns whether from_func and to_func are equivalent. There are cases
        (e.g. BT601, BT709, and BT2020_10) where several functions are functionally
        identical. In these cases, when doing conversion, we should consider them
        as equivalent. Also, BT2020_12 is the same as the aforementioned three for
        less than 12 bits per pixel.

        Args:
            from_func: GstVideo.VideoTransferFunction to convert from
            from_bpp: bits per pixel to convert from
            to_func: GstVideo.VideoTransferFunction to convert into
            to_bpp: bits per pixel to convert into

        Returns:
            TRUE if from_func and to_func can be considered equivalent.
        """
    @staticmethod
    def to_iso(func: VideoTransferFunction) -> _int:
        """Converts GstVideo.VideoTransferFunction to the "transfer characteristics"
        (TransferCharacteristics) value defined by "ISO/IEC 23001-8 Section 7.2 Table 3"
        and "ITU-T H.273 Table 3".
        "H.264 Table E-4" and "H.265 Table E.4" share the identical values.

        Args:
            func: a GstVideo.VideoTransferFunction

        Returns:
            The value of ISO/IEC 23001-8 transfer characteristics.
        """

class VideoVBIEncoder:
    """An encoder for writing ancillary data to the
    Vertical Blanking Interval lines of component signals.
    """
    def add_ancillary(self, composite: _bool, DID: _int, SDID_block_number: _int, data: _bytes) -> _bool:
        """Stores Video Ancillary data, according to SMPTE-291M specification.

        Note that the contents of the data are always read as 8bit data (i.e. do not contain
        the parity check bits).

        Args:
            composite: True if composite ADF should be created, component otherwise
            DID: The Data Identifier
            SDID_block_number: The Secondary Data Identifier (if type 2) or the Data
                Block Number (if type 1)
            data: The user data content of the Ancillary packet.
                Does not contain the ADF, DID, SDID nor CS.

        Returns:
            True if enough space was left in the current line, False
                otherwise.
        """
    def copy(self) -> VideoVBIEncoder: ...
    def free(self) -> None:
        """Frees the self."""
    def write_line(self, data: _int) -> None: ...
    @classmethod
    def new(cls, format: VideoFormat, pixel_width: _int) -> VideoVBIEncoder | None:
        """Create a new GstVideo.VideoVBIEncoder for the specified format and pixel_width.

        Args:
            format: a GstVideo.VideoFormat
            pixel_width: The width in pixel to use

        Returns:
            The new GstVideo.VideoVBIEncoder or None if the format and/or pixel_width
                is not supported.
        """

class VideoVBIParser:
    """A parser for detecting and extracting GstVideoAncillary data from
    Vertical Blanking Interval lines of component signals.
    """
    def add_line(self, data: _bytes) -> None:
        """Provide a new line of data to the self. Call GstVideo.VideoVBIParser.get_ancillary()
        to get the Ancillary data that might be present on that line.

        Args:
            data: The line of data to parse
        """
    def copy(self) -> VideoVBIParser: ...
    def free(self) -> None:
        """Frees the self."""
    def get_ancillary(self) -> _tuple[VideoVBIParserResult, VideoAncillary]:
        """Parse the line provided previously by GstVideo.VideoVBIParser.add_line().

        Returns:
            GstVideo.VideoVBIParserResult.OK if ancillary data was found and
                anc was filled. GstVideo.VideoVBIParserResult.DONE if there wasn't any
                data.
            anc: a GstVideo.VideoAncillary to start the eventual ancillary data
        """
    @classmethod
    def new(cls, format: VideoFormat, pixel_width: _int) -> VideoVBIParser | None:
        """Create a new GstVideo.VideoVBIParser for the specified format and pixel_width.

        Args:
            format: a GstVideo.VideoFormat
            pixel_width: The width in pixel to use

        Returns:
            The new GstVideo.VideoVBIParser or None if the format and/or pixel_width
                is not supported.
        """

class VideoVBIParserResult(GObject.GEnum):
    """Return values for GstVideo.VideoVBIParser"""
    DONE: VideoVBIParserResult
    """No line were provided, or no more Ancillary data was found."""
    OK: VideoVBIParserResult
