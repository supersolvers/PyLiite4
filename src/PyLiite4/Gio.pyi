    ANONYMOUS: UnixSocketAddressType
    """anonymous"""
    PATH: UnixSocketAddressType
    """a filesystem path"""
    ABSTRACT: UnixSocketAddressType
    """an abstract name"""
    ABSTRACT_PADDED: UnixSocketAddressType
    """an abstract name, 0-padded
      to the full length of a unix socket name
    """

