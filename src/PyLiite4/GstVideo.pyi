    matrix: _list[_float]
    meta: Gst.Meta
    def apply_matrix(self, matrix: _list[_float]) -> None:
        """Apply a transformation using the given 4x4 transformation matrix.
        Performs the multiplication, meta->matrix X matrix.

        Args:
