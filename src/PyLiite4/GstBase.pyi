def type_find_helper_for_buffer(obj: Gst.Object | None, buf: Gst.Buffer) -> _tuple[Gst.Caps | None, Gst.TypeFindProbability]:
    """Tries to find what type of data is contained in the given Gst.Buffer, the
    assumption being that the buffer represents the beginning of the stream or
    file.

    All available typefinders will be called on the data in order of rank. If
    a typefinding function returns a probability of Gst.TypeFindProbability.MAXIMUM,
    typefinding is stopped immediately and the found caps will be returned
    right away. Otherwise, all available typefind functions will the tried,
    and the caps with the highest probability will be returned, or None if
    the content of the buffer could not be identified.

    Args:
        obj: object doing the typefinding, or None (used for logging)
        buf: a Gst.Buffer with data to typefind

    Returns:
        the Gst.Caps corresponding to the data,
            or None if no type could be found. The caller should free the caps
            returned with gst_caps_unref().
        prob: location to store the probability of the found
            caps, or None
    """

