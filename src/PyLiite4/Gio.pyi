    INVALID_ARGUMENT: IOErrorEnum
    """Invalid argument."""
    PERMISSION_DENIED: IOErrorEnum
    """Permission denied."""
    NOT_SUPPORTED: IOErrorEnum
    """Operation (or one of its parameters) not supported"""
    NOT_MOUNTED: IOErrorEnum
    """File isn't mounted."""
    ALREADY_MOUNTED: IOErrorEnum
    """File is already mounted."""
    CLOSED: IOErrorEnum
    """File was closed."""
    CANCELLED: IOErrorEnum
    """Operation was cancelled. See Gio.Cancellable."""
    PENDING: IOErrorEnum
