class ToastOverlay(Gtk.Widget):
    """A widget showing toasts above its content.

    Much like Gtk.Overlay, `Adw.ToastOverlay` is a container with a single
    main child, on top of which it can display a Toast, overlaid.
    Toasts can be shown with ToastOverlay.add_toast().

    Use ToastOverlay.dismiss_all() to dismiss all toasts at once, or
    Toast.dismiss() to dismiss a single toast.

    See Toast for details.

    ## CSS nodes

    ```
    toastoverlay
    ├── [child]
    ├── toast
    ┊   ├── widget
    ┊   │   ├── [label.heading]
        │   ╰── [custom title]
        ├── [button]
        ╰── button.circular.flat
    ```

    `Adw.ToastOverlay`'s CSS node is called `toastoverlay`. It contains the child,
    as well as zero or more `toast` subnodes.

    Each of the `toast` nodes contains a `widget` subnode, optionally a `button`
    subnode, and another `button` subnode with `.circular` and `.flat` style
    classes.

    The `widget` subnode contains a `label` subnode with the `.heading` style
    class, or a custom widget provided by the application.

    ## Accessibility

    `Adw.ToastOverlay` uses the Gtk.AccessibleRole.GROUP role.
    """
    props: _ToastOverlayProps  # type: ignore[assignment]
    def __init__(self, *, child: Gtk.Widget = ..., can_focus: _Any = ..., can_target: _Any = ..., css_classes: _Any = ..., css_name: _Any = ..., cursor: _Any = ..., focus_on_click: _Any = ..., focusable: _Any = ..., halign: _Any = ..., has_tooltip: _Any = ..., height_request: _Any = ..., hexpand: _Any = ..., hexpand_set: _Any = ..., layout_manager: _Any = ..., limit_events: _Any = ..., margin_bottom: _Any = ..., margin_end: _Any = ..., margin_start: _Any = ..., margin_top: _Any = ..., name: _Any = ..., opacity: _Any = ..., overflow: _Any = ..., receives_default: _Any = ..., sensitive: _Any = ..., tooltip_markup: _Any = ..., tooltip_text: _Any = ..., valign: _Any = ..., vexpand: _Any = ..., vexpand_set: _Any = ..., visible: _Any = ..., width_request: _Any = ..., accessible_role: _Any = ..., **properties: _Any) -> None: ...
