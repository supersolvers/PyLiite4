    @property
    def invalidate_size(self) -> _SignalMethod[_Callable[[Paintable], None], _Callable[[], None]]:
        """Called by implementations of `Gdk.Paintable` to invalidate their size.

        As long as the size is not invalidated, self must return the same
        values for its intrinsic width, height and aspect ratio.

