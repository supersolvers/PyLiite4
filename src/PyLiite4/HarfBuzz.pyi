def aat_layout_feature_type_get_name_id(face: face_t, feature_type: aat_layout_feature_type_t) -> ot_name_id_t:
    """Fetches the name identifier of the specified feature type in the face's `name` table.

    Args:
        face: #hb_face_t to work upon
        feature_type: The #hb_aat_layout_feature_type_t of the requested feature type

    Returns:
        Name identifier of the requested feature type
    """

def aat_layout_feature_type_get_selector_infos(face: face_t, feature_type: aat_layout_feature_type_t, start_offset: _int) -> _tuple[_int, _list[aat_layout_feature_selector_info_t], _int]:
    """Fetches a list of the selectors available for the specified feature in the given face.

    If upon return, default_index is set to HarfBuzz.AAT_LAYOUT_NO_SELECTOR_INDEX, then
    the feature type is non-exclusive.  Otherwise, default_index is the index of
    the selector that is selected by default.

    Args:
        face: #hb_face_t to work upon
        feature_type: The #hb_aat_layout_feature_type_t of the requested feature type
        start_offset: offset of the first feature type to retrieve

    Returns:
        Number of all available feature selectors
        selectors: A buffer pointer. The selectors available for the feature type queries.
        default_index: The index of the feature's default selector, if any
    """

class aat_layout_feature_type_t(GObject.GEnum):
    """The possible feature types defined for AAT shaping, from Apple [Font Feature Registry](https://developer.apple.com/fonts/TrueType-Reference-Manual/RM09/AppendixF.html)."""
    INVALID: aat_layout_feature_type_t
    """Initial, unset feature type"""
    ALL_TYPOGRAPHIC: aat_layout_feature_type_t
    """[All Typographic Features](https://developer.apple.com/fonts/TrueType-Reference-Manual/RM09/AppendixF.html#Type0)"""
    LIGATURES: aat_layout_feature_type_t
    """[Ligatures](https://developer.apple.com/fonts/TrueType-Reference-Manual/RM09/AppendixF.html#Type1)"""
    CURSIVE_CONNECTION: aat_layout_feature_type_t
    """[Cursive Connection](https://developer.apple.com/fonts/TrueType-Reference-Manual/RM09/AppendixF.html#Type2)"""
    LETTER_CASE: aat_layout_feature_type_t
