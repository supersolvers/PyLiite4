        Returns:
            an application name.
        """
    def match(self, info_b: RecentInfo) -> _bool:
        """Checks whether two `Gtk.RecentInfo` point to the same resource.

        Args:
            info_b: a `Gtk.RecentInfo`

        Returns:
            True if both `Gtk.RecentInfo` point to the same
                resource, False otherwise
        """
    def ref(self) -> RecentInfo:
        """Increases the reference count of recent_info by one.

        Returns:
            the recent info object with its reference count
