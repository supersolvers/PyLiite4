        region_to_add is not modified.

        Args:
            region_to_add: the GtkSource.Region to add to self, or None.
        """
    def add_subregion(self, _start: Gtk.TextIter, _end: Gtk.TextIter) -> None:
        """Adds the subregion delimited by _start and _end to self.

        Args:
            _start: the start of the subregion.
            _end: the end of the subregion.
        """
    def get_bounds(self) -> _tuple[_bool, Gtk.TextIter, Gtk.TextIter]:
