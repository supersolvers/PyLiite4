        The frame is not considered finished until the whole frame
        is finished or dropped by the subclass.

        Args:
            frame: the GstVideo.VideoCodecFrame

        Returns:
            a Gst.FlowReturn, usually GST_FLOW_OK.
        """
    def finish_frame(self, frame: VideoCodecFrame) -> Gst.FlowReturn:
