    @staticmethod
    def next(iter: MessageHeadersIter) -> _tuple[_bool, MessageHeadersIter, _str, _str]:
        """Yields the next name/value pair in the MessageHeaders being
        iterated by iter.

        If iter has already yielded the last header, then
        MessageHeadersIter.next() will return False and name and value
        will be unchanged.

        Args:
            iter: a Soup.MessageHeadersIter

        Returns:
            True if another name and value were returned, False
                if the end of the headers has been reached.
            iter: a Soup.MessageHeadersIter
            name: pointer to a variable to return
                the header name in
            value: pointer to a variable to return
                the header value in
        """

