<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="AdwStatusPage" id="preview">
    <property name="title" translatable="yes">Open File</property>
    <property name="description" translatable="yes">Open a file using a file dialog</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">24</property>
        <child>
          <object class="GtkButton" id="button_single">
            <property name="halign">center</property>
            <property name="label" translatable="yes">Open File…</property>
            <style>
              <class name="pill"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_image">
            <property name="halign">center</property>
            <property name="label" translatable="yes">Open Image…</property>
            <style>
              <class name="pill"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_multiple">
            <property name="halign">center</property>
            <property name="label" translatable="yes">Open Multiple Files…</property>
            <style>
              <class name="pill"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">API Reference</property>
            <property name="uri">https://docs.gtk.org/gtk4/class.FileDialog.html</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkFileFilter" id="file_filter_image">
    <mime-types>
      <mime-type>image/svg+xml</mime-type>
      <mime-type>image/png</mime-type>
      <mime-type>image/jpeg</mime-type>
      <mime-type>image/webp</mime-type>
      <mime-type>image/gif</mime-type>
    </mime-types>
  </object>
</interface>
