class ByteReader:
    """GstBase.ByteReader provides a byte reader that can read different integer and
    floating point types from a memory buffer. It provides functions for reading
    signed/unsigned, little/big endian integers of 8, 16, 24, 32 and 64 bits
    and functions for reading little/big endian floating points numbers of
    32 and 64 bits. It also provides functions to read NUL-terminated strings
    in various character encodings.
    """
    byte: _int
    size: _int
    data: _bytes
    def dup_data(self) -> _tuple[_bool, _bytes]:
        """Returns a newly-allocated copy of the current data
        position if at least size bytes are left and
        updates the current position.

        Returns:
            True if successful, False otherwise.
            val: address of a
                #guint8 pointer variable in which to store the result
        """
    def dup_string_utf16(self) -> _tuple[_bool, _list[_int]]:
        """Returns a newly-allocated copy of the current data position if there is
        a NUL-terminated UTF-16 string in the data (this could be an empty string
        as well), and advances the current position.

        No input checking for valid UTF-16 is done. This function is endianness
        agnostic - you should not assume the UTF-16 characters are in host
        endianness.

        This function will fail if no NUL-terminator was found in in the data.

        Note: there is no peek or get variant of this function to ensure correct
        byte alignment of the UTF-16 string.

        Returns:
            True if a string could be read, False otherwise. The
                string put into str.
            str: address of a
                #guint16 pointer variable in which to store the result
        """
    def dup_string_utf32(self) -> _tuple[_bool, _list[_int]]:
        """Returns a newly-allocated copy of the current data position if there is
        a NUL-terminated UTF-32 string in the data (this could be an empty string
        as well), and advances the current position.

        No input checking for valid UTF-32 is done. This function is endianness
        agnostic - you should not assume the UTF-32 characters are in host
        endianness.

        This function will fail if no NUL-terminator was found in in the data.

        Note: there is no peek or get variant of this function to ensure correct
        byte alignment of the UTF-32 string.

        Returns:
            True if a string could be read, False otherwise. The
                string put into str.
            str: address of a
                #guint32 pointer variable in which to store the result
        """
    def dup_string_utf8(self) -> _tuple[_bool, _list[_str]]:
        """FIXME:Reads (copies) a NUL-terminated string in the GstBase.ByteReader instance,
        advancing the current position to the byte after the string. This will work
        for any NUL-terminated string with a character width of 8 bits, so ASCII,
        UTF-8, ISO-8859-N etc. No input checking for valid UTF-8 is done.

        This function will fail if no NUL-terminator was found in in the data.

        Returns:
            True if a string could be read into str, False otherwise. The
                string put into str.
            str: address of a
                #gchar pointer variable in which to store the result
        """
    def free(self) -> None:
        """Frees a GstBase.ByteReader instance, which was previously allocated by
        GstBase.ByteReader.new().
        """
    def get_data(self) -> _tuple[_bool, _bytes]:
        """Returns a constant pointer to the current data
        position if at least size bytes are left and
        updates the current position.

        Returns:
            True if successful, False otherwise.
            val: address of a
                #guint8 pointer variable in which to store the result
        """
    def get_float32_be(self) -> _tuple[_bool, _float]:
        """Read a 32 bit big endian floating point value into val
        and update the current position.

        Returns:
            True if successful, False otherwise.
            val: Pointer to a #gfloat to store the result
        """
    def get_float32_le(self) -> _tuple[_bool, _float]:
        """Read a 32 bit little endian floating point value into val
        and update the current position.

