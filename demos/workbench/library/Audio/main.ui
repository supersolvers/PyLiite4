<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="audio">
    <property name="title" translatable="yes">Audio</property>
    <property name="description" translatable="yes">Play Audio with media controls</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="halign">fill</property>
        <child>
          <object class="AdwClamp">
            <property name="maximum-size">400</property>
            <child>
              <object class="GtkMediaControls" id="controls"/>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="margin-top">12</property>
            <property name="orientation">horizontal</property>
            <property name="halign">center</property>
            <style>
              <class name="linked"/>
            </style>
            <child>
              <object class="GtkButton" id="button_sound">
                <property name="label" translatable="yes">Play Sound</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_music">
                <property name="label" translatable="yes">Play Music</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="margin-top">48</property>
            <property name="spacing">6</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">Media Controls API Reference</property>
                <property name="uri">https://docs.gtk.org/gtk4/class.MediaControls.html</property>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">Media File API Reference</property>
                <property name="uri">https://docs.gtk.org/gtk4/class.MediaFile.html</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
