        """The virtual method behind get_cancel_progress(), for subclasses to override."""
    def do_get_distance(self) -> _float:
        """The virtual method behind get_distance(), for subclasses to override."""
    def do_get_progress(self) -> _float:
        """The virtual method behind get_progress(), for subclasses to override."""
    def do_get_snap_points(self) -> _list[_float]:
