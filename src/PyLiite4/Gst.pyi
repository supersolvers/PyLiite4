    def __init__(self, *, name: _str = ..., parent: Object = ..., **properties: _Any) -> None: ...
    def control_source_get_value(self, timestamp: ClockTime) -> _tuple[_bool, _float]:
        """Gets the value for this Gst.ControlSource at a given timestamp.

        Args:
            timestamp: the time for which the value should be returned

        Returns:
            False if the value couldn't be returned, True otherwise.
            value: the value
        """
    def control_source_get_value_array(self, timestamp: ClockTime, interval: ClockTime, values: _list[_float]) -> _bool:
        """Gets an array of values for for this Gst.ControlSource. Values that are
        undefined contain NANs.

        Args:
            timestamp: the first timestamp
            interval: the time steps
            values: array to put control-values in

        Returns:
            True if the given array could be filled, False otherwise
        """

