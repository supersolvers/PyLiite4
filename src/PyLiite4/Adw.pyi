class AccentColor(GObject.GEnum):
    """Describes the available system accent colors."""
    BLUE: AccentColor
    """Use a blue color (`#3584e4` or `#0073e5` in Yaru). This is the default value."""
    TEAL: AccentColor
    """Use a teal color (`#2190a4` or `#4b8501` in Yaru)."""
    GREEN: AccentColor
    """Use a green color (`#3a944a` or `#4b8501` in Yaru)."""
    YELLOW: AccentColor
    """Use a yellow color (`#c88800`)."""
    ORANGE: AccentColor
    """Use a orange color (`#ed5b00` or `#e95420` in Yaru)."""
    RED: AccentColor
    """Use a red color (`#e62d42` or `#da3450` in Yaru)."""
    PINK: AccentColor
    """Use a pink color (`#d56199` or `#b34cb3` in Yaru)."""
    PURPLE: AccentColor
    """Use a purple color (`#9141ac` or `#7764d8` in Yaru)."""
    SLATE: AccentColor
    """Use a slate color (`#6f8396` or `#657b69` in Yaru)."""
    BROWN: AccentColor
    @staticmethod
    def to_rgba(self_: AccentColor) -> Gdk.RGBA:
        """Converts self to a `Gdk.RGBA` representing its background color.

        The matching foreground color is white.

        Args:
            self_: an accent color

        Returns:
            return location for the color
        """
    @staticmethod
    def to_standalone_rgba(self_: AccentColor, dark: _bool) -> Gdk.RGBA:
        """Converts self to a `Gdk.RGBA` representing its standalone color.

        It will typically be darker for light background, and lighter for dark
        background, ensuring contrast.

        Args:
            self_: an accent color
            dark: Whether to calculate standalone color for light or dark background

        Returns:
            return location for the color
        """

