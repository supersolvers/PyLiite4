    """State during normal operation"""
    ACTIVE: StateFlags
    """Widget is active"""
    PRELIGHT: StateFlags
    """Widget has a mouse pointer over it"""
    SELECTED: StateFlags
    """Widget is selected"""
    INSENSITIVE: StateFlags
    """Widget is insensitive"""
    INCONSISTENT: StateFlags
    """Widget is inconsistent"""
