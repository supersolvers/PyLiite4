class StackTransitionType(GObject.GEnum):
    """Possible transitions between pages in a `Gtk.Stack` widget.

    New values may be added to this enumeration over time.
    """
    NONE: StackTransitionType
    """No transition"""
    CROSSFADE: StackTransitionType
    """A cross-fade"""
    SLIDE_RIGHT: StackTransitionType
    """Slide from left to right"""
    SLIDE_LEFT: StackTransitionType
    """Slide from right to left"""
    SLIDE_UP: StackTransitionType
    """Slide from bottom up"""
    SLIDE_DOWN: StackTransitionType
    """Slide from top down"""
    SLIDE_LEFT_RIGHT: StackTransitionType
    """Slide from left or right according to the children order"""
    SLIDE_UP_DOWN: StackTransitionType
    """Slide from top down or bottom up according to the order"""
    OVER_UP: StackTransitionType
    """Cover the old page by sliding up"""
    OVER_DOWN: StackTransitionType
    """Cover the old page by sliding down"""
    OVER_LEFT: StackTransitionType
    """Cover the old page by sliding to the left"""
    OVER_RIGHT: StackTransitionType
    """Cover the old page by sliding to the right"""
    UNDER_UP: StackTransitionType
    """Uncover the new page by sliding up"""
    UNDER_DOWN: StackTransitionType
    """Uncover the new page by sliding down"""
    UNDER_LEFT: StackTransitionType
    """Uncover the new page by sliding to the left"""
    UNDER_RIGHT: StackTransitionType
    """Uncover the new page by sliding to the right"""
    OVER_UP_DOWN: StackTransitionType
    """Cover the old page sliding up or uncover the new page sliding down, according to order"""
    OVER_DOWN_UP: StackTransitionType
    """Cover the old page sliding down or uncover the new page sliding up, according to order"""
    OVER_LEFT_RIGHT: StackTransitionType
    """Cover the old page sliding left or uncover the new page sliding right, according to order"""
    OVER_RIGHT_LEFT: StackTransitionType
    """Cover the old page sliding right or uncover the new page sliding left, according to order"""
    ROTATE_LEFT: StackTransitionType
    """Pretend the pages are sides of a cube and rotate that cube to the left"""
    ROTATE_RIGHT: StackTransitionType
    """Pretend the pages are sides of a cube and rotate that cube to the right"""
    ROTATE_LEFT_RIGHT: StackTransitionType
    """Pretend the pages are sides of a cube and rotate that cube to the left or right according to the children order"""

class StateFlags(GObject.GFlags):
    """Describes a widget state.

    Widget states are used to match the widget against CSS pseudo-classes.
    Note that GTK extends the regular CSS classes and sometimes uses
    different names.
