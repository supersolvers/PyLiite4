    def do_get_item_attribute_value(self, item_index: _int, attribute: _str, expected_type: GLib.VariantType | None = ...) -> GLib.Variant | None:
        """The virtual method behind get_item_attribute_value(), for subclasses to override."""
    def do_get_item_attributes(self, item_index: _int) -> _dict[_str, GLib.Variant]:
        """Gets all the attributes associated with the item in the menu model.

        Args:
            item_index: The Gio.MenuItem to query

        Returns:
            Attributes on the item
        """
