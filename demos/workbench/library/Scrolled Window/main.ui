<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="scrolled_window_demo">
    <property name="title" translatable="yes">Scrolled Window</property>
    <property name="description" translatable="yes">A container that makes its child scrollable</property>
    <child>
      <object class="AdwClamp">
        <child>
          <object class="GtkBox">
            <property name="hexpand">true</property>
            <property name="vexpand">true</property>
            <property name="spacing">12</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox">
                <property name="halign">center</property>
                <property name="spacing">18</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Orientation</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="margin-start">6</property>
                    <property name="homogeneous">true</property>
                    <property name="halign">center</property>
                    <style>
                      <class name="linked"/>
                    </style>
                    <child>
                      <object class="GtkToggleButton" id="toggle_orientation">
                        <property name="label" translatable="yes">Horizontal</property>
                        <property name="active">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkToggleButton">
                        <property name="label" translatable="yes">Vertical</property>
                        <property name="group">toggle_orientation</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label" translatable="yes">Go To</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <child>
                      <object class="GtkButton" id="button_start">
                        <property name="label" translatable="yes">Start</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="button_end">
                        <property name="label" translatable="yes">End</property>
                      </object>
                    </child>
                    <style>
                      <class name="linked"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scrolled_window">
                <property name="margin-bottom">24</property>
                <property name="margin-top">24</property>
                <property name="has-frame">true</property>
                <property name="propagate-natural-height">true</property>
                <property name="max-content-height">300</property>
                <child>
                  <object class="GtkBox" id="container">
                    <property name="homogeneous">true</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLinkButton">
                <property name="label" translatable="yes">API Reference</property>
                <property name="uri">https://docs.gtk.org/gtk4/class.ScrolledWindow.html</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
