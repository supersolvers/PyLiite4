        """The virtual method behind get_internal_time(), for subclasses to override."""
    def do_get_resolution(self) -> ClockTime:
        """The virtual method behind get_resolution(), for subclasses to override."""
    def do_unschedule(self, entry: ClockEntry) -> None:
        """Unblock a blocking or async wait operation.

        Args:
            entry: the entry to unschedule
        """
    def do_wait(self, entry: ClockEntry) -> _tuple[ClockReturn, ClockTimeDiff]:
        """Perform a blocking wait on the given Gst.ClockEntry and return
        the jitter.

        Args:
            entry: the entry to wait on

        Returns:
            the result of the blocking wait. Gst.ClockReturn.EARLY will be returned
                if the current clock time is past the time of id, Gst.ClockReturn.OK if
                id was scheduled in time. Gst.ClockReturn.UNSCHEDULED if id was
                unscheduled with Gst.Clock.id_unschedule().
            jitter: a pointer that will contain the jitter
        """
    def do_wait_async(self, entry: ClockEntry) -> ClockReturn:
        """Perform an asynchronous wait on the given Gst.ClockEntry.

        Args:
            entry: the entry to wait on

        Returns:
            the result of the non blocking wait.
        """
