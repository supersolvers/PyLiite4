        You might use this function to implement a “window resize grip.”

        Args:
            edge: the edge or corner from which the drag is started
            device: the device used for the operation
            button: the button being used to drag, or 0 for a keyboard-initiated drag
            x: surface X coordinate of mouse click that began the drag
            y: surface Y coordinate of mouse click that began the drag
            timestamp: timestamp of mouse click that began the drag (use
                Gdk.Event.get_time())
        """
    def focus(self, timestamp: _int) -> None:
        """Sets keyboard focus to surface.

        In most cases, [Gtk.Window.present_with_time()](../gtk4/method.Window.present_with_time.html)
        should be used on a [GtkWindow](../gtk4/class.Window.html), rather than
        calling this function.

        Args:
            timestamp: timestamp of the event triggering the surface focus
        """
    def get_capabilities(self) -> ToplevelCapabilities:
        """The capabilities that are available for this toplevel.

        Returns:
            the capabilities of the `Gdk.Toplevel`.
        """
    def get_gravity(self) -> Gravity:
