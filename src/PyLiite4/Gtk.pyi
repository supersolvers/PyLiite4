    def update_platform_state(self, state: AccessiblePlatformState) -> None:
        """Informs ATs that the platform state has changed.

        This function should be used by `Gtk.Accessible` implementations that
        have a platform state but are not widgets. Widgets handle platform
        states automatically.

        Args:
            state: the platform state to update
        """
    def update_property(self, properties: _list[AccessibleProperty], values: _list[GObject.Value]) -> None:
        """Updates an array of accessible properties.

        This function should be called by `Gtk.Widget` types whenever an accessible
        property change must be communicated to assistive technologies.

        This function is meant to be used by language bindings.

        Args:
            properties: an array of accessible properties
            values: an array of `GValues`, one for each property
        """
    def update_relation(self, relations: _list[AccessibleRelation], values: _list[GObject.Value]) -> None:
        """Updates an array of accessible relations.

        This function should be called by `Gtk.Widget` types whenever an accessible
        relation change must be communicated to assistive technologies.

        This function is meant to be used by language bindings.

        Args:
            relations: an array of accessible relations
            values: an array of `GValues`, one for each relation
        """
    def update_state(self, states: _list[AccessibleState], values: _list[GObject.Value]) -> None:
        """Updates an array of accessible states.

        This function should be called by `Gtk.Widget` types whenever an accessible
        state change must be communicated to assistive technologies.

        This function is meant to be used by language bindings.

        Args:
            states: an array of accessible states
            values: an array of `GValues`, one for each state
        """
    def do_get_accessible_id(self) -> _str | None:
        """The virtual method behind get_accessible_id(), for subclasses to override."""
    def do_get_accessible_parent(self) -> Accessible | None:
        """The virtual method behind get_accessible_parent(), for subclasses to override."""
    def do_get_at_context(self) -> ATContext | None:
        """The virtual method behind get_at_context(), for subclasses to override."""
    def do_get_bounds(self) -> _tuple[_bool, _int, _int, _int, _int]:
        """The virtual method behind get_bounds(), for subclasses to override."""
    def do_get_first_accessible_child(self) -> Accessible | None:
        """The virtual method behind get_first_accessible_child(), for subclasses to override."""
    def do_get_next_accessible_sibling(self) -> Accessible | None:
        """The virtual method behind get_next_accessible_sibling(), for subclasses to override."""
    def do_get_platform_state(self, state: AccessiblePlatformState) -> _bool:
        """The virtual method behind get_platform_state(), for subclasses to override."""
    @property
    def accessible_role(self) -> AccessibleRole:
        """The accessible role of the given `Gtk.Accessible` implementation.

        The accessible role cannot be changed once set.
        """
    @accessible_role.setter
    def accessible_role(self, value: AccessibleRole) -> None: ...

class AccessibleAnnouncementPriority(GObject.GEnum):
    """The priority of an accessibility announcement."""
