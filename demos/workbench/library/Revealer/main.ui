<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <object class="AdwStatusPage" id="revealer">
    <property name="title" translatable="yes">Revealer</property>
    <property name="description" translatable="yes">Animates the transition of its child from invisible to visible</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">24</property>
        <child>
          <object class="GtkBox">
            <property name="homogeneous">true</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox">
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkToggleButton" id="button_slide">
                    <property name="halign">center</property>
                    <property name="label" translatable="yes">Slide</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="AdwClamp">
                    <child>
                      <object class="GtkRevealer" id="revealer_slide">
                        <property name="transition-duration">300</property>
                        <property name="transition-type">slide-up</property>
                        <child>
                          <object class="GtkListBox">
                            <property name="selection-mode">none</property>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title" translatable="yes">Item 1</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title" translatable="yes">Item 2</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title" translatable="yes">Item 3</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title" translatable="yes">Item 4</property>
                              </object>
                            </child>
                            <style>
                              <class name="boxed-list"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="margin-start">24</property>
                <property name="margin-end">24</property>
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <child>
                  <object class="GtkToggleButton" id="button_crossfade">
                    <property name="halign">center</property>
                    <property name="label" translatable="yes">Crossfade</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkOverlay">
                    <child>
                      <object class="GtkPicture" id="image1"/>
                    </child>
                    <child type="overlay">
                      <object class="GtkRevealer" id="revealer_crossfade">
                        <property name="transition-duration">800</property>
                        <property name="transition-type">crossfade</property>
                        <child>
                          <object class="GtkPicture" id="image2"/>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLinkButton">
            <property name="label" translatable="yes">API Reference</property>
            <property name="uri">https://docs.gtk.org/gtk4/class.Revealer.html</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
