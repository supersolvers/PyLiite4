            idx: the index
            buffer: a Gst.Buffer
        """
    def length(self) -> _int:
        """Returns the number of buffers in self.

        Returns:
            the number of buffers in the buffer list
        """
    def remove(self, idx: _int, length: _int) -> None:
        """Removes length buffers starting from idx in self. The following buffers
        are moved to close the gap.

